# Sporta — publish credentials. Copy to .env.deploy and fill in.
# .env.deploy is git-ignored. Never commit it, never upload it to the server.
#
# hPanel -> Files -> FTP Accounts. Create an account scoped to public_html and
# use it here. If it ever leaks, delete it in hPanel and make a new one; that is
# the whole reason this uses Hostinger's own FTP auth instead of a deploy script
# on the server.

FTP_HOST=ftp.sporta.com.kw
FTP_USER=
FTP_PASSWORD=

# Optional. Only set FTP_PORT if hPanel shows something other than 21.
# FTP_PORT=21

# Leave FTP_INSECURE unset. It disables TLS certificate verification and exists
# only for testing against a self-signed local server.
# FTP_INSECURE=1
