{
  "about": "Rules for scripts/unknown-files-scan.mjs (npm run audit:unknown-files). Paths are relative to the repository root. RULES are ordered, first match wins: glob -> purpose -> owner -> expected? -> ships to web?. A file with no rule is explained only if another code/config file names it; otherwise it is UNKNOWN. A rule explains what a file IS; it does not excuse what it CONTAINS: the content and path detectors run on every file, rule or no rule. Read ops/FILES-SCAN.md before editing.",
  "version": 1,
  "zones": [
    {
      "glob": [
        "sporta-web/public/**",
        "sporta-web/dropin/**",
        "sporta-web/index.html",
        "sporta-html5/**",
        "sporta-live/**"
      ],
      "zone": "web"
    },
    {
      "glob": [
        "sporta-web/src/**"
      ],
      "zone": "client"
    }
  ],
  "shipped_js_hosts": ["sporta.com.kw", "use.typekit.net", "p.typekit.net", "fonts.googleapis.com", "fonts.gstatic.com", "accounts.google.com", "www.googleapis.com", "oauth2.googleapis.com", "wa.me", "graph.facebook.com", "kpay.com.kw", "kpaytest.com.kw", "pg.cbk.com", "pgtest.cbk.com", "www.instagram.com", "www.tiktok.com"],
  "mcp_servers_ok": ["elevenlabs"],
  "name_nonascii_ok": [],
  "hidden_ok": [
    ".gitignore",
    ".mcp.json",
    ".claude/**",
    ".vscode/**",
    "sporta-html5/.htaccess",
    "sporta-web/.gitignore",
    "sporta-web/.env.example",
    "sporta-web/.env.deploy.example",
    "sporta-web/.nvmrc",
    "sporta-web/.node-version",
    "sporta-web/dropin/php-cbk/.htaccess",
    "sporta-web/dropin/php-knet/.htaccess",
    "sporta-web/dropin/php-store/.htaccess",
    "sporta-web/public/.htaccess"
  ],
  "executables": [
    "**/*.sh"
  ],
  "test_credential_globs": [
    "sporta-web/scripts/**",
    "sporta-web/ops/**",
    "sporta-live/**/test/**"
  ],
  "no_secret_scan": [
    "sporta-web/package-lock.json",
    "sporta-web/seo-lastmod.json"
  ],
  "secret_placeholders": [
    "YOUR_TERMINAL_RESOURCE_KEY",
    "YOUR_TRANPORTAL_PASSWORD",
    "YOUR_TRANPORTAL_ID",
    "YOUR_CLIENT_SECRET",
    "YOUR_ENCRP_KEY",
    "YOUR_DB_PASSWORD",
    "change-me",
    "changeme",
    "CHANGE_ME"
  ],
  "zip_member_map": [
    {
      "prefix": "api/",
      "to": "sporta-web/dropin/php-store/"
    }
  ],
  "zip_root_twin": "sporta-web/public/",
  "trees": [
    {
      "dir": "sporta-html5",
      "what": "no-build HTML5 fallback of the store (generated by build-html5.mjs)",
      "ships": "no: make-package.mjs and vps-deploy.mjs both leave it out"
    },
    {
      "dir": "sporta-app",
      "what": "Flutter app skeleton (cannot build: no assets, no platform folders)",
      "ships": "no"
    },
    {
      "dir": "sporta-live",
      "what": "copies of the live add-ons and server-only files, described by its MANIFEST.md",
      "ships": "no: nothing builds or deploys from it"
    },
    {
      "dir": "brand",
      "what": "brand masters and the generators that make shipped art",
      "ships": "no, by design (kept out of public/)"
    }
  ],
  "package_rules": [
    {
      "id": "PKG-VITE-ENTRY",
      "glob": [
        "public_html/index.html"
      ],
      "purpose": "Vite build of sporta-web/index.html (regenerated on every build)"
    },
    {
      "id": "PKG-VITE-ASSETS",
      "glob": [
        "public_html/assets/**"
      ],
      "purpose": "hashed Vite output (entry, route chunks, css)"
    },
    {
      "id": "PKG-SQL-NUMBERED",
      "glob": [
        "database-sql/*.sql"
      ],
      "purpose": "make-package.mjs: install SQL, numbered copies of dropin/php-store/*.mysql.sql"
    },
    {
      "id": "PKG-README",
      "glob": [
        "README-FIRST.txt",
        "sporta-mac-check.sh"
      ],
      "purpose": "make-package.mjs: written / copied beside public_html"
    }
  ],
  "package_regenerated": [
    "public_html/index.html",
    "public_html/sw.js",
    "public_html/.htaccess"
  ],
  "rules": [
    {
      "id": "R-IGN-NODE-MODULES",
      "glob": [
        "sporta-web/node_modules/"
      ],
      "purpose": "npm ci output (ignored folder, one entry, contents not read)",
      "owner": "npm / package-lock.json",
      "web": false,
      "optional": true
    },
    {
      "id": "R-IGN-DIST",
      "glob": [
        "sporta-web/dist/",
        "sporta-html5/dist/"
      ],
      "purpose": "vite build output (ignored folder, one entry, contents not read)",
      "owner": "npm run build / the shared test rig",
      "web": false,
      "optional": true
    },
    {
      "id": "R-IGN-RIG-CONFIG",
      "glob": [
        "sporta-web/dropin/php-*/config.php"
      ],
      "tracked": false,
      "test_values": true,
      "purpose": "test-rig config.php written by the suites (ignored, never committed; test values only)",
      "owner": "scripts/sandbox.sh + native-backend-test.mjs",
      "web": false,
      "optional": true
    },
    {
      "id": "R-IGN-GENERATED-ZIP",
      "glob": [
        "SPORTA-GO-LIVE.zip",
        "SPORTA-PAYMENTS-FIX.zip",
        "SPORTA-ASSETS-FIX.zip",
        "SPORTA-WEBSITE.pdf",
        "SPORTA-BACKEND-UPLOAD/**"
      ],
      "tracked": false,
      "archive_ok": true,
      "binary_ok": true,
      "purpose": "generated upload packages (ignored)",
      "owner": "npm run package / package:backend / package:pay",
      "web": false,
      "optional": true
    },
    {
      "id": "R-IGN-PACKAGE-STAGE",
      "glob": [
        ".package-stage/**"
      ],
      "tracked": false,
      "purpose": "make-package.mjs staging folder (transient)",
      "owner": "scripts/make-package.mjs",
      "web": false,
      "optional": true
    },
    {
      "id": "R-IGN-ENV-DEPLOY",
      "glob": [
        "sporta-web/.env.deploy",
        "sporta-web/.env"
      ],
      "tracked": false,
      "purpose": "local credentials file (ignored; never committed, never packaged)",
      "owner": "the owner",
      "web": false,
      "optional": true
    },
    {
      "id": "R-ROOT-DOCS",
      "glob": [
        "README.md",
        "CLAUDE.md",
        "GO-LIVE.md",
        "KNET.md",
        "SERVER-LAYOUT.md",
        "DEPLOY-AUTOMATION.md",
        "N8N-SECURITY.md",
        "CATALOGUE-IMPORT.md",
        "DNS-EMAIL-RECORDS.txt"
      ],
      "purpose": "project documentation and owner instructions",
      "owner": "owner / sessions",
      "web": false
    },
    {
      "id": "R-ROOT-REPORTS",
      "glob": [
        "VPS-SCAN-2026-10-31.md",
        "DATA-SCAN-2026-11-02.md"
      ],
      "refsource": false,
      "purpose": "dated scan reports (they list open weaknesses and name many files, so they do not count as references)",
      "owner": "scan workflows",
      "web": false
    },
    {
      "id": "R-ROOT-SCRIPTS",
      "glob": [
        "scan-server-response.sh",
        "server-perf.sh",
        "sporta-mac-setup.sh"
      ],
      "refs": "required",
      "purpose": "root shell tools (post-deploy HTTP scan, server timing, Mac setup)",
      "owner": "GO-LIVE.md / owner",
      "web": false
    },
    {
      "id": "R-ROOT-CONFIG",
      "glob": [
        ".gitignore",
        ".mcp.json",
        "vercel.json",
        ".claude/settings.json",
        ".vscode/*.json"
      ],
      "purpose": "repo and editor configuration",
      "owner": "owner / sessions",
      "web": false
    },
    {
      "id": "R-ROOT-BACKEND-ZIP",
      "glob": [
        "SPORTA-BACKEND.zip"
      ],
      "tracked": true,
      "purpose": "August 2026 admin-only backend bundle from npm run package:backend; .gitignore forbids it and it is tracked anyway (stale)",
      "owner": "an early session",
      "web": false,
      "optional": true
    },
    {
      "id": "R-BRAND-PYCACHE",
      "glob": [
        "brand/**/__pycache__/**"
      ],
      "purpose": "compiled Python cache of brand/hero/grade.py, committed by accident",
      "owner": "python import of brand/hero/grade.py",
      "web": false,
      "optional": true
    },
    {
      "id": "R-BRAND-SUPPLIER",
      "glob": [
        "brand/ahed-supplier/**"
      ],
      "purpose": "supplier price-list screenshots behind data/ahed.json (wholesale cost data in a public repo)",
      "owner": "scripts/generate-ahed.mjs / owner",
      "web": false
    },
    {
      "id": "R-BRAND-DOCS",
      "glob": [
        "brand/**/*.md"
      ],
      "purpose": "notes for the brand masters",
      "owner": "brand lane",
      "web": false
    },
    {
      "id": "R-BRAND-GENERATORS",
      "glob": [
        "brand/**/*.{py,mjs,js,glsl,json}"
      ],
      "purpose": "generators and settings that make the shipped art",
      "owner": "brand lane",
      "web": false
    },
    {
      "id": "R-BRAND-MASTERS",
      "glob": [
        "brand/**/*.{png,jpg,jpeg,webp,svg,woff2}"
      ],
      "large_ok": true,
      "purpose": "brand masters and sources (kept out of public/ so they are never uploaded)",
      "owner": "brand lane",
      "web": false
    },
    {
      "id": "R-APP-FLUTTER",
      "glob": [
        "sporta-app/**/*.{dart,yaml,md}"
      ],
      "purpose": "Flutter skeleton that cannot build; ships nowhere",
      "owner": "an early session",
      "web": false
    },
    {
      "id": "R-HTML5-FALLBACK",
      "glob": [
        "sporta-html5/**/*.{html,js,css,png,xml,txt,md}",
        "sporta-html5/.htaccess"
      ],
      "purpose": "no-build fallback site; not packaged, not deployed",
      "owner": "scripts/build-html5.mjs",
      "web": false
    },
    {
      "id": "R-LIVE-MANIFEST",
      "glob": [
        "sporta-live/MANIFEST.md",
        "sporta-live/*/README.md"
      ],
      "purpose": "describes the live add-ons (its repo-copy claim is stale: sporta-web/public/ is the source)",
      "owner": "an early deploy session",
      "web": false
    },
    {
      "id": "R-LIVE-UNIQUE",
      "glob": [
        "sporta-live/hero/**",
        "sporta-live/policy/**",
        "sporta-live/php/**",
        "sporta-live/admin/google_sub.mysql.sql",
        "sporta-live/birthday/birthday.mysql.sql",
        "sporta-live/*/test/**"
      ],
      "purpose": "server-only sources with no twin in sporta-web (htaccess redirects, php ini, re-encode script, tests)",
      "owner": "deploy sessions",
      "web": false
    },
    {
      "id": "R-LIVE-COPY",
      "glob": [
        "sporta-live/**/*.{css,js,php}"
      ],
      "purpose": "copy of a live add-on or birthday file (many are older than sporta-web/public)",
      "owner": "an early deploy session",
      "web": false
    },
    {
      "id": "R-WEB-REPORTS",
      "glob": [
        "sporta-web/*-{AUDIT,SCAN}-*.md"
      ],
      "refsource": false,
      "purpose": "dated audit/scan reports",
      "owner": "audit workflows",
      "web": false
    },
    {
      "id": "R-WEB-DOCS",
      "glob": [
        "sporta-web/*.md"
      ],
      "purpose": "sporta-web documentation",
      "owner": "sessions",
      "web": false
    },
    {
      "id": "R-WEB-CONFIG",
      "glob": [
        "sporta-web/package.json",
        "sporta-web/package-lock.json",
        "sporta-web/vite.config.js",
        "sporta-web/tailwind.config.js",
        "sporta-web/postcss.config.js",
        "sporta-web/jsconfig.json",
        "sporta-web/tsconfig.json",
        "sporta-web/.nvmrc",
        "sporta-web/.node-version",
        "sporta-web/.gitignore",
        "sporta-web/.env.example",
        "sporta-web/.env.deploy.example",
        "sporta-web/deploy.config.json",
        "sporta-web/index.html"
      ],
      "purpose": "build, toolchain and example-environment configuration; index.html is the Vite entry",
      "owner": "owner / sessions",
      "web": false
    },
    {
      "id": "R-WEB-GENERATED-SEO",
      "glob": [
        "sporta-web/seo-lastmod.json"
      ],
      "purpose": "last-modified dates written by generate-seo.mjs",
      "owner": "scripts/generate-seo.mjs",
      "web": false
    },
    {
      "id": "R-WEB-DATA-AHED",
      "glob": [
        "sporta-web/data/ahed.json"
      ],
      "flag": {
        "detector": "D-SENSITIVE-DATA",
        "severity": "medium",
        "kind": "other",
        "evidence": "supplier name, per-SKU wholesale costs and invoice totals in a public repository (with 13 supplier screenshots in brand/ahed-supplier/ and the seed's cost_aed): REPO-SCAN hygiene-1",
        "action": "owner decides whether this data may stay public; history keeps it either way"
      },
      "purpose": "supplier cost table behind src/lib/ahed.js (wholesale costs in a public repo)",
      "owner": "scripts/generate-ahed.mjs",
      "web": false
    },
    {
      "id": "R-WEB-DOCS-ARCHIVE",
      "glob": [
        "sporta-web/docs/**"
      ],
      "purpose": "archived reference copies (PHP kept as .txt so it cannot run) and the live schema",
      "owner": "sessions",
      "web": false
    },
    {
      "id": "R-ADDONS-SRC",
      "glob": [
        "sporta-web/addons-src/**"
      ],
      "purpose": "commented sources of slimmed add-on CSS",
      "owner": "scripts/build-addon-css.mjs",
      "web": false
    },
    {
      "id": "R-DROPIN-PHP",
      "glob": [
        "sporta-web/dropin/php-*/**/*.php"
      ],
      "refs": "required",
      "web": true,
      "purpose": "backend endpoints copied by bundle-php.mjs to api/, knet/, pay/ (the live backend)",
      "owner": "backend lanes"
    },
    {
      "id": "R-DROPIN-SQL",
      "glob": [
        "sporta-web/dropin/php-store/*.sql"
      ],
      "web": true,
      "purpose": "database migrations (ship in api/, denied by that folder's .htaccess)",
      "owner": "backend lanes"
    },
    {
      "id": "R-DROPIN-OTHER",
      "glob": [
        "sporta-web/dropin/**/.htaccess",
        "sporta-web/dropin/**/*.md",
        "sporta-web/dropin/n8n/*.json"
      ],
      "web": true,
      "purpose": "per-folder access rules, READMEs and the n8n handoff workflow export",
      "owner": "backend lanes"
    },
    {
      "id": "R-OPS-RULES",
      "glob": [
        "sporta-web/ops/known-files.json",
        "sporta-web/ops/live-files-scan.compose.json"
      ],
      "refsource": false,
      "purpose": "the rules of the repo scan and the one-shot live job: their text names bad file names (shell.php, config.php ...) on purpose, so they are not a reference that explains a file",
      "owner": "unknown-files lanes",
      "web": false
    },
    {
      "id": "R-OPS",
      "glob": [
        "sporta-web/ops/**/*.{md,mjs,sh,sql,json,patch,diff,cnf}"
      ],
      "purpose": "operations packs: database hardening, backups, privacy, audit and scan jobs",
      "owner": "ops lanes",
      "web": false
    },
    {
      "id": "R-PUBLIC-ADDON-CSS",
      "glob": [
        "sporta-web/public/{sporta-product-fix,sporta-brand-theme,sporta-home-trim,sporta-cart-drawer,sporta-grid,sporta-bag-touch,sporta-cat-tiles,sporta-admin-knet,sporta-returns-touch,sporta-clock,sporta-ui-colours,sporta-checkout-a11y,sporta-shadows,sporta-images}.css"
      ],
      "web": true,
      "purpose": "add-on stylesheet linked by the LIVE index.html (CLAUDE.md, item 5)",
      "owner": "storefront / admin lanes"
    },
    {
      "id": "R-PUBLIC-ADDON-JS",
      "glob": [
        "sporta-web/public/{boot,config,birthday,sporta-features,sporta-admin-brands,sporta-footer-call,sporta-gov-autopick,sporta-clock,sporta-checkout-a11y}.js"
      ],
      "web": true,
      "purpose": "add-on script linked by the LIVE index.html (config.js is never overwritten on deploy)",
      "owner": "storefront / admin lanes"
    },
    {
      "id": "R-PUBLIC-PWA",
      "glob": [
        "sporta-web/public/{sw.js,site.webmanifest,backends.webmanifest,backends-offline.html,backends-offline.css,backends-icon.svg}"
      ],
      "web": true,
      "purpose": "service worker, manifests and the admin offline page",
      "owner": "storefront / admin lanes"
    },
    {
      "id": "R-PUBLIC-SEO",
      "glob": [
        "sporta-web/public/{robots.txt,llms.txt,sitemap.xml,sitemap-pages.xml,sitemap-products.xml}"
      ],
      "web": true,
      "purpose": "crawler files (sitemaps regenerated by generate-seo.mjs)",
      "owner": "SEO lane"
    },
    {
      "id": "R-PUBLIC-BRAND",
      "glob": [
        "sporta-web/public/{logo.png,logo-white.png,logo-white.webp,favicon.png,favicon-32.png,favicon-192.png,apple-touch-icon.png,og-image.png,product-photo-unavailable.svg}"
      ],
      "web": true,
      "purpose": "logos, icons, social card, placeholder photo",
      "owner": "brand lane"
    },
    {
      "id": "R-PUBLIC-HTACCESS",
      "glob": [
        "sporta-web/public/.htaccess"
      ],
      "web": true,
      "purpose": "Apache rules: HTTPS, headers, CSP, route list",
      "owner": "security / deploy lanes"
    },
    {
      "id": "R-PUBLIC-SETUP-TOOL",
      "glob": [
        "sporta-web/public/go-live.html"
      ],
      "web": true,
      "purpose": "owner-run readiness page; held back by vps-deploy.mjs (SETUP_TOOLS) and not re-uploaded by publish-ftps unless --setup-tools",
      "owner": "go-live lane"
    },
    {
      "id": "R-PUBLIC-FONTS",
      "glob": [
        "sporta-web/public/fonts/*.woff2"
      ],
      "web": true,
      "purpose": "self-hosted Alexandria and IBM Plex subsets",
      "owner": "fonts lane"
    },
    {
      "id": "R-PUBLIC-CATS",
      "glob": [
        "sporta-web/public/cats/{desktop,mobile}/*.{jpg,webp}"
      ],
      "web": true,
      "purpose": "category tile art (CategoryTile assembles the URLs from parts)",
      "owner": "brand lane"
    },
    {
      "id": "R-PUBLIC-HERO",
      "glob": [
        "sporta-web/public/hero/{desktop,mobile}/*.webp"
      ],
      "web": true,
      "purpose": "home hero slides (HeroSlider assembles the URLs from parts)",
      "owner": "brand lane"
    },
    {
      "id": "R-SRC",
      "glob": [
        "sporta-web/src/**/*.{js,jsx,css,json}"
      ],
      "web": true,
      "purpose": "React storefront and admin source (bundled by Vite; imported without extensions, so no literal path names these files)",
      "owner": "storefront / admin lanes"
    },
    {
      "id": "R-SCRIPTS-SCANNERS",
      "glob": [
        "sporta-web/scripts/*-scan.mjs",
        "sporta-web/scripts/sec-*.mjs",
        "sporta-web/scripts/*-audit.mjs",
        "sporta-web/scripts/*-inventory.mjs",
        "sporta-web/scripts/unknown-files-*.mjs",
        "sporta-web/scripts/live-files-*.mjs",
        "sporta-web/scripts/make-expected-manifest.mjs",
        "sporta-web/scripts/xss-*-test.mjs",
        "sporta-web/scripts/file-names-test.mjs",
        "sporta-web/scripts/htaccess-rules-test.mjs"
      ],
      "refs": "required",
      "refsource": false,
      "purpose": "scanners, auditors and their suites: their source NAMES bad files on purpose (shell.php, c99, config.php ...), so it must not count as a reference that explains a file",
      "owner": "security / scan lanes",
      "web": false
    },
    {
      "id": "R-SCRIPTS-FIXTURES",
      "glob": [
        "sporta-web/scripts/fixtures/**/*.{html,css,json,mjs,php}"
      ],
      "purpose": "verbatim markup and data the suites run against",
      "owner": "test lanes",
      "web": false
    },
    {
      "id": "R-SCRIPTS-LIB",
      "glob": [
        "sporta-web/scripts/lib/*.{mjs,php}"
      ],
      "refs": "required",
      "purpose": "shared helpers for suites and scans",
      "owner": "test lanes",
      "web": false
    },
    {
      "id": "R-SCRIPTS",
      "glob": [
        "sporta-web/scripts/*.{mjs,cjs,sh,py,php}"
      ],
      "refs": "required",
      "purpose": "build, deploy, test and audit scripts (REPO-SCAN hygiene-13 lists the ones no package.json script runs)",
      "owner": "all lanes",
      "web": false
    }
  ],
  "content_allow": [
    {"path": "sporta-web/src/lib/bidi.js", "detector": "D-BIDI-IN-SOURCE", "max": 3, "reason": "the bidi helper: its unbidi() character class holds the control characters it strips, written as literal characters (three hits, no more). Reviewed by the verifier 2026-11-04: the file is the app's own and has no other use of them; writing them as \\u escapes would remove the hit"},
    {
      "path": "sporta-web/scripts/{unknown-files-scan,unknown-files-test,live-files-scan,make-expected-manifest,sec-config-scan}.mjs",
      "detector": "D-PHP-SHELLSIG",
      "reason": "scanner source: the signatures are the patterns it searches for, not code it runs"
    },
    {
      "path": "sporta-web/scripts/unknown-files-test.mjs",
      "detector": "D-JS-DECODE",
      "max": 1,
      "reason": "the suite writes eval(atob(...)) into a scratch copy to prove the detector; the line is a template literal, never executed"
    },
    {
      "path": "sporta-web/dropin/php-store/admin.php",
      "detector": "D-PHP-VARFUNC",
      "max": 1,
      "reason": "$inventorySku(...) calls a closure defined a few lines above that normalises a SKU; the function is not chosen by request data (admin.php, inventory list)"
    },
    {
      "path": "sporta-web/dropin/php-knet/setup-config.php",
