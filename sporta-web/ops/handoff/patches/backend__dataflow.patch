+// [F1-02] WHAT THE LANGUAGE MODEL NEVER NEEDS. The model only rewords a fixed shop sentence (assistant_llm_rewordable:
+// a search result, a hello, a thank-you); the customer's own words reach it only so it can answer in the same tone
+// and language. A customer who writes "do you have the black hoodie, call me on 9XXXXXXX" or pastes an email address
+// or an order number was sending that to the AI provider, which the privacy page does not name. So phone numbers,
+// email addresses, order numbers and any other run of seven or more digits are replaced before the request is built.
+// The n8n handoff keeps them on purpose: a person who is asked to call a customer back needs the number.
+function assistant_redact_for_model(string $s): string
+{
+    $s = assistant_redact($s);
+    $s = preg_replace('/[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}/u', '[email removed]', $s) ?? $s;
+    $s = preg_replace('/(?<![A-Za-z0-9])SP(?=[A-Z0-9]*\d)[A-Z0-9]{4,}(?![A-Za-z0-9])/u', '[order number removed]', $s) ?? $s;
+    $s = preg_replace('/(?<![\p{Nd}])(?:(?:\+|00)?\s?965[\s\-.]?)?[569](?:[\s\-.]?\p{Nd}){7}(?![\p{Nd}])/u', '[phone removed]', $s) ?? $s;
+    $s = preg_replace('/(?<![\p{Nd}])\p{Nd}(?:[\s\-.]?\p{Nd}){6,}(?![\p{Nd}])/u', '[number removed]', $s) ?? $s;
+    return $s;
+}
