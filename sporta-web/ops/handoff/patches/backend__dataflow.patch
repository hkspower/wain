+// [F1-05] WHAT THE PAYMENT LOG RECORDS. The privacy page lists what the shop keeps and a visitor's network address is not
+// on it, while this log is append-only, has no rotation and sits in the same private directory as the backups of
+// everything else. The log needs a network to tell a bank retry from a stranger; it does not need the person. So
+// IPv4 is written with the last octet zeroed and IPv6 as its /48, unless the owner sets `log_full_client_ip` => true
+// in this gateway's config (a dispute with the bank may want the full address). Rate limiting is not affected: it
+// keys on knet_client_ip() and an HMAC, never on this.
+function knet_log_ip(array $cfg): string
+{
+    $ip = knet_client_ip($cfg);
+    if (!empty($cfg['log_full_client_ip'])) return $ip;
+    if (filter_var($ip, FILTER_VALIDATE_IP, FILTER_FLAG_IPV4)) return (string) preg_replace('/\.\d+$/', '.0', $ip);
+    if (filter_var($ip, FILTER_VALIDATE_IP, FILTER_FLAG_IPV6)) {
+        $packed = @inet_pton($ip);
+        return $packed === false ? 'unknown' : (string) inet_ntop(substr($packed, 0, 6) . str_repeat("\0", 10)) . '/48';
+    }
+    return 'unknown';
+}
