+/* [F2-02] Customer sign-out forgets what this device remembered for checkout.
+ * "Remember these details on this device" (ON by default) keeps the customer's name, mobile number, full address and
+ * delivery note in localStorage under "sporta.delivery", and the one-tap quick checkout reads it back. Signing out of the
+ * account did not touch it, so on a shared phone or computer the NEXT person's checkout opened on the previous person's
+ * name, number and address (measured). When the server confirms a customer sign-out (POST customer.php?r=logout answered
+ * with a success status), this removes that one key. The bag and wishlist are left alone: they hold no personal data.
+ * Nothing else about fetch changes: same arguments, same promise, same result; a rejected or non-2xx sign-out removes
+ * nothing, because the account is then still signed in. */
+;(function () {
+  'use strict'
+  try {
+    var nativeFetch = window.fetch
+    if (typeof nativeFetch !== 'function') return
+    window.fetch = function (input, init) {
+      var promise = nativeFetch.apply(this, arguments)
+      try {
+        var url = typeof input === 'string' ? input : input && input.url ? input.url : String(input)
+        var method = String((init && init.method) || (input && input.method) || 'GET').toUpperCase()
+        if (method === 'POST' && /\/customer\.php\?r=logout(?:&|$)/.test(url)) {
+          promise.then(function (res) {
+            if (!res || !res.ok) return
+            try { localStorage.removeItem('sporta.delivery') } catch (_) {}
+          }, function () {})
+        }
+      } catch (_) {}
+      return promise
+    }
+  } catch (_) {}
+})()
