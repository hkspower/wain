+        . '<title>Sporta</title></head><body style="font-family:system-ui,sans-serif;margin:0;padding:48px 20px;text-align:center;color:#171A1E">'
+        . '<main style="max-width:30rem;margin:0 auto"><p style="font-size:1.1rem;line-height:1.7">' . $msg . '</p>'
+        . '<p><a href="/' . ($isEn ? '?lang=en' : '') . '" style="color:#B8430F;font-weight:700">' . $back . '</a></p></main></body></html>');
