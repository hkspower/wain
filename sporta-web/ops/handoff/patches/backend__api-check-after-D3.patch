+++ b/sporta-web/dropin/php-cbk/reconcile.php
@@ -0,0 +1,113 @@ [API-01 A3-F01 reconcile job (host cron, CLI only)]
+<?php
+// T-Pay / KNET-via-CBK RECONCILIATION (API check 2026-11-04, PHP-SCAN robust-2). Host scheduler only:
+//
+//   */10 * * * *  docker exec -u www-data apache-sporta-1 php /var/www/html/pay/reconcile.php --run
+//   php reconcile.php --check      lists what it WOULD do and changes nothing
+//
+// WHY IT EXISTS. The bank's browser return is the only confirmation this shop ever
+// gets (CBK does not call the server). If Authenticate or GetTransactions fails at
+// that instant (a CBK incident, a 30 s timeout), callback.php redirects the shopper
+// to an error page and the order stays `pending` with the money captured. Measured
+// on a private stack: after stock_hold_minutes cron-stock.php gave the garments
+// away, the order was left pending/unfulfilled, and nothing ever asked CBK again;
+// cbk_verify_by_track() had no caller. This job asks, with CBK's Verify call, about
+// every order that was handed to the bank page (pay_attempt >= 1) and is still
+// pending 3-100 minutes later (the sweeper acts at 120).
+//
+// WHAT IT DOES, deliberately little. It never marks anything PAID: settling a
+// payment is the transaction in callback.php / the admin's card_settled. When Verify
+// says "captured, for exactly this order's amount, under this order's own reference"
+// the order is moved pending -> `review` with cbk_message VERIFIED_CAPTURE_UNSETTLED
+// and a system event is written (the Activity page). `review` keeps the garments
+// claimed (cron-stock leaves a review order alone unless a person cancelled it) and
+// puts the order in front of the operator, who settles it with the existing
+// card_settled action after looking at the bank statement. FAIL CLOSED: a reply that
+// is not a JSON object with Status "1", a PayId (or TrackId) equal to the reference
+// asked about, and an Amount equal to the order's amount in fils changes nothing and
+// is logged. The shape of Verify's reply is assumed to match GetTransactions' entity
+// (manual v2.93, Payment Details); CHECK IT AGAINST CBK'S TEST GATEWAY before
+// scheduling, and if it differs the job simply reports and changes nothing.
+declare(strict_types=1);
+require __DIR__ . '/cbk.php';
+
+if (PHP_SAPI !== 'cli' || !in_array($argv[1] ?? '', ['--run', '--check'], true)) {
+    http_response_code(404);   // pay/ is web-reachable: this job has no HTTP face at all
+    exit;
+}
+$dry = ($argv[1] === '--check');
+$cfg = cbk_with_store_db(cbk_load_config(__DIR__ . '/config.php'));
+if (!cbk_db_configured($cfg)) { fwrite(STDERR, "orders database is not configured\n"); exit(1); }
+cbk_assert_payment_config($cfg);
+
+$pdo = cbk_pdo($cfg);
+$methods = ['tpay'];
+if (!empty($cfg['knet_via_cbk'])) $methods[] = 'knet';
+$in = implode(',', array_fill(0, count($methods), '?'));
+$q = $pdo->prepare(
+    "select id, track_id, amount, pay_attempt from orders
+      where payment_method in ($in) and payment_status = 'pending' and pay_attempt >= 1
+        and stock_released = 0 and fulfilment_status <> 'cancelled'
+        and created_at < (now() - interval 3 minute) and created_at > (now() - interval 100 minute)
+      order by id limit 50"
+);
+$q->execute($methods);
+$rows = $q->fetchAll(PDO::FETCH_ASSOC);
+
+$lib = dirname(__DIR__) . '/api/store.php';
+if (!is_file($lib)) $lib = dirname(__DIR__) . '/php-store/store.php';
+$haveStore = is_file($lib);
+if ($haveStore) require_once $lib;
+
+// The reference CBK was given for attempt n: the track id for attempt 1, then the
+// same shortening cbk_attempt_ref() applies (never trim the suffix).
+$refFor = static function (string $track, int $n): string {
+    if ($n <= 1) return $track;
+    $suffix = 'A' . $n;
+    return substr($track, 0, max(1, 30 - strlen($suffix))) . $suffix;
+};
+
+$report = ['candidates' => count($rows), 'moved_to_review' => [], 'not_paid' => 0, 'unclear' => 0, 'dry_run' => $dry];
+$token = null;
+foreach ($rows as $o) {
+    $expected = cbk_amount_fils((string) $o['amount']);
+    $found = null;
+    for ($n = 1; $n <= (int) $o['pay_attempt'] && $found === null; $n++) {
+        $ref = $refFor((string) $o['track_id'], $n);
+        try {
+            $token ??= cbk_get_access_token($cfg);
+            $res = cbk_verify_by_track($cfg, $ref, $token);
+        } catch (Throwable $e) {
+            cbk_log($cfg, 'reconcile.error', ['trackid' => $o['track_id'], 'error' => substr($e->getMessage(), 0, 160)]);
+            $report['unclear']++;
+            continue 2;     // CBK unreachable: leave the order alone, try again next run
+        }
+        if (!is_array($res)) { $report['unclear']++; continue; }
+        $status = (string) ($res['Status'] ?? '');
+        if ($status !== '1') { if ($status === '2' || $status === '3') $report['not_paid']++; continue; }
+        $payId = (string) ($res['PayId'] ?? ($res['TrackId'] ?? ''));
+        $paid = cbk_amount_fils((string) ($res['Amount'] ?? ''));
+        if (!hash_equals($ref, $payId) || $expected === null || $expected <= 0 || $paid !== $expected) {
+            cbk_log($cfg, 'reconcile.unmatched', ['trackid' => $o['track_id'], 'ref' => $ref, 'status' => $status]);
+            $report['unclear']++;
+            continue;
+        }
+        $found = $res;
+    }
+    if ($found === null) continue;
+    $report['moved_to_review'][] = $o['track_id'];
+    if ($dry) continue;
+    $u = $pdo->prepare(
+        "update orders set payment_status = 'review', cbk_status = '1', cbk_message = 'VERIFIED_CAPTURE_UNSETTLED',
+                cbk_paymentid = ?, cbk_transaction = ?, cbk_authcode = ?, cbk_reference = ?, cbk_receipt = ?, cbk_paytype = ?
+          where id = ? and payment_status = 'pending' and stock_released = 0"
+    );
+    $u->execute([
+        substr((string) ($found['PaymentId'] ?? ''), 0, 60), (string) ($found['TransactionId'] ?? ''), (string) ($found['AuthCode'] ?? ''),
+        (string) ($found['ReferenceId'] ?? ''), (string) ($found['ReceiptNo'] ?? ''), (string) ($found['PayType'] ?? ''), (int) $o['id'],
+    ]);
+    if ($u->rowCount() === 1) {
+        cbk_log($cfg, 'reconcile.captured_unsettled', ['trackid' => $o['track_id']]);
+        if ($haveStore) store_system_event($pdo, 'tpay_capture_unsettled_' . strtolower(preg_replace('/[^A-Za-z0-9]/', '', (string) $o['track_id'])));
+    }
+}
+echo json_encode($report), "\n";
