+    $dir  = $isEn ? 'ltr' : 'rtl';
+    $lang = $isEn ? 'en' : 'ar';
+    exit('<!doctype html><html lang="' . $lang . '" dir="' . $dir . '"><head><meta charset="utf-8">'
