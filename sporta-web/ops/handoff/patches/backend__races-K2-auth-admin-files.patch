+// RACE K2-5: one lock per brand slug, held to the end of the request. See
+// brand_delete / brand_assign / product_save.
+function store_brand_lock(PDO $db, string $slug): void {
+    $name = 'sporta:brand:' . substr(hash('sha256', strtolower(trim($slug))), 0, 40);
+    $q = $db->prepare('select get_lock(?, 10)');
+    $q->execute([$name]);
+    if ((int)$q->fetchColumn() !== 1) store_fail('brand_busy', 503);
+    register_shutdown_function(static function () use ($db, $name): void {
+        try { $db->prepare('select release_lock(?)')->execute([$name]); }
+        catch (Throwable $e) { error_log('Sporta brand lock release failed'); }
+    });
+}
+
+// RACE K2-2: a gateway config file (knet-config.php / pay-config.php) is edited
+// by FOUR routes below - payment_config, payment_identifiers, payment_server_ips
+// and payment_knet_via_cbk - and every one of them READ the whole file, changed
+// a key or two and wrote the WHOLE file back (temp file + rename). The rename is
+// atomic, the read-modify-write around it was not: two admins saving at once
+// (one session id serialises its own requests, two admins have two) both started
+// from the same bytes, the later rename won, and the earlier save - a replaced
+// secret, a switched knet_via_cbk, a server IP - was erased without an error.
+//
+// One advisory lock per file, taken BEFORE the file is read and held until the
+// request ends (store_out exits, the shutdown hook releases it, and closing the
+// connection would anyway), and the file is read again UNDER the lock. A lock in
+// MariaDB rather than a lock FILE beside the config: the private config
+// directory is a read-only mount on the VPS, and every writer here already
+// holds a database connection.
+function store_config_file_exclusive(PDO $db, string $path): ?array {
+    $name = 'sporta:cfgfile:' . substr(hash('sha256', $path), 0, 40);
+    $q = $db->prepare('select get_lock(?, 15)');
+    $q->execute([$name]);
+    if ((int)$q->fetchColumn() !== 1) store_fail('config_busy', 503);
+    register_shutdown_function(static function () use ($db, $name): void {
+        try { $db->prepare('select release_lock(?)')->execute([$name]); }
+        catch (Throwable $e) { error_log('Sporta config lock release failed'); }
+    });
+    // What another request wrote a moment ago must be what this one reads: drop
+    // any cached stat and compiled copy first.
+    clearstatcache(true, $path);
+    if (function_exists('opcache_invalidate')) @opcache_invalidate($path, true);
+    if (!is_file($path)) return null;
+    $value = require $path;
+    return is_array($value) ? $value : null;
+}
