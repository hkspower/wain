+// WHICH DATABASE ACCOUNT THIS REQUEST CONNECTS AS (ops/db/README.md, "tier 2").
+//
+// One PHP code base serves three very different jobs, and a database account
+// should only be as strong as the job. The entry script decides:
+//   admin  admin.php, admin-google.php, preflight.php   -> db_admin_user / db_admin_pass
+//   cron   cron-*.php (host cron and the keyed HTTP doors) -> db_cron_user / db_cron_pass
+//   (anything else: the storefront, checkout, SEO pages)   -> db_user / db_pass
+// A role whose pair is absent, empty or half-set uses db_user / db_pass, so
+// this code is safe to deploy BEFORE the config or the accounts exist: with no
+// new key it behaves exactly as before. The storefront account is the default
+// on purpose: a new entry script nobody listed gets the LEAST power, and the
+// suite (test:db-least-privilege) lists every entry script and fails on one it
+// does not know.
+function store_db_role(): string {
+    $script = basename((string)($_SERVER['SCRIPT_FILENAME'] ?? ''));
+    if (in_array($script, ['admin.php', 'admin-google.php', 'preflight.php'], true)) return 'admin';
+    if (str_starts_with($script, 'cron-')) return 'cron';
+    return '';
+}
+
+/** @return array{0:string,1:string} user and password for this request's role */
+function store_db_credentials(array $c): array {
+    $user = (string)($c['db_user'] ?? '');
+    $pass = (string)($c['db_pass'] ?? '');
+    $role = store_db_role();
+    if ($role === '') return [$user, $pass];
+    // The key names are written out (not built from $role) so a search for
+    // db_cron_user finds this line, and the config-rules suite can see them.
+    [$ru, $rp] = $role === 'admin'
+        ? [$c['db_admin_user'] ?? '', $c['db_admin_pass'] ?? '']
+        : [$c['db_cron_user'] ?? '', $c['db_cron_pass'] ?? ''];
+    if (is_string($ru) && $ru !== '' && is_string($rp) && $rp !== '') return [$ru, $rp];
+    if ($ru !== '' || $rp !== '') {
+        error_log("Sporta: db_{$role}_user and db_{$role}_pass must both be set; using db_user");
+    }
+    return [$user, $pass];
+}
