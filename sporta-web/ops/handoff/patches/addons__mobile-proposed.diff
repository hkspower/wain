 })()
+
+/* [MC-12 = M1-04] Installed app (Add to Home Screen, display: standalone / iOS navigator.standalone) only. The compiled
+ * pull-to-refresh listens on window for touchmove and, after a 144 px downward drag from scrollY 0, calls location.reload()
+ * with no check of where the touch began. Measured: a 270 px pull on /checkout reloaded the page and the typed name was
+ * gone; dragging down inside the bag drawer to scroll its list back up (page at scrollY 0) reloaded the app. A short 80 px
+ * pull does nothing, and a pull on the home page must still refresh. This capture-phase listener keeps the app's handler
+ * from seeing a touchmove where a reload would lose work: the form pages, and anything that starts inside a dialog, the
+ * bag drawer or a field. stopImmediatePropagation does not cancel the browser's own scrolling. A tab in a browser is
+ * not affected (the compiled handler only runs when standalone). */
+;(function () {
+  'use strict'
+  var FORMS = /^\/(checkout|account|support|returns|exchange|track|contact)(\/|$)/
+  function guarded(e) {
+    if (FORMS.test(location.pathname)) return true
+    var t = e.target
+    return !!(t && t.closest && t.closest('[role="dialog"], .campaign-cart-drawer, input, textarea, select'))
+  }
+  addEventListener('touchmove', function (e) { if (guarded(e)) e.stopImmediatePropagation() }, { capture: true, passive: true })
+})()
