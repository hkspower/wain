diff --git a/sporta-web/public/boot.js b/sporta-web/public/boot.js
index baa6b1f..1709eba 100644
--- a/sporta-web/public/boot.js
+++ b/sporta-web/public/boot.js
@@ -139,3 +139,43 @@
   if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', wire, { once: true })
   else wire()
 })()
+
+/* [MC-07 = M2-01 + M2-V2] First visit, home page: the hero picture waited for React. boot.js already preloads
+ * /hero/<device>/strength.webp (32 kB), and it has arrived by about 1.9 s on a throttled phone (Slow 4G, 4x CPU), but the
+ * boot shell's .boot-hero is an empty charcoal box, so the largest contentful paint only happened when React mounted
+ * (2.4-3.9 s). Painting the same, already-downloaded file into the shell moved the LCP element from 3.2 s to 1.9 s in
+ * 6 interleaved A/B pairs (M2 lens; no extra bytes, CLS unchanged); in the synthesis proof (uncompressed mirror, Slow 4G, 4x CPU, n=3)
+ * the median went 7.2 s -> 4.7 s and the hero was painted before React mounted in 3 of 3 loads against 0 of 3. React replaces #root's content on mount, so there is
+ * nothing to clean up. HONEST CAVEAT: this is the built-in "strength" artwork, which is also what the app paints first
+ * today until the owner's own slides arrive (/api?r=slides) and replace it; the shell shows it sooner, it does not remove
+ * that swap (the real cure is a rebuild that waits for the slides, or a preload of slide 1). Delete this block to undo. */
+;(function () {
+  'use strict'
+  try {
+    if (location.pathname !== '/' && location.pathname !== '/index.html') return
+    var link = document.querySelector('link[rel="preload"][as="image"][href^="/hero/"]')
+    if (!link) return
+    var src = link.getAttribute('href')
+    var place = function () {
+      var box = document.querySelector('.boot-hero')
+      if (!box) return false
+      if (box.querySelector('img')) return true
+      var img = new Image()
+      img.alt = ''
+      img.decoding = 'async'
+      img.setAttribute('fetchpriority', 'high')
+      img.src = src
+      img.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center top'
+      var shade = document.createElement('div')
+      shade.style.cssText = 'position:absolute;inset:0;background:linear-gradient(#0000 15%,#0f121714 34%,#0f1217ab 68%,#0f1217e6 100%)'
+      box.style.position = 'relative'
+      box.appendChild(img)
+      box.appendChild(shade)
+      return true
+    }
+    if (place()) return
+    var mo = new MutationObserver(function () { if (place()) mo.disconnect() })
+    mo.observe(document.documentElement, { childList: true, subtree: true })
+    document.addEventListener('DOMContentLoaded', function () { place(); mo.disconnect() }, { once: true })
+  } catch (e) { /* the shell is decoration: never break first paint */ }
+})()
diff --git a/sporta-web/public/sporta-admin-brands.js b/sporta-web/public/sporta-admin-brands.js
