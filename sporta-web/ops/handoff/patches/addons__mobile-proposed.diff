+
+/* [MC-01 = M1-01 + M1-MISS-1] Checkout area list: a finger that lands on an option to SCROLL the list used to PICK it.
+ * The compiled picker (Checkout chunk, component de()) puts onPointerDown={e => {e.preventDefault(), pick(t)}} on every <li>.
+ * A touch pointerdown fires at touch-START, before the browser knows the gesture is a scroll, so dragging the 97-row list
+ * chose the row under the finger (Dasman / Mirqab) and this file then switched the governorate to match: a wrong delivery
+ * area without a deliberate choice (6 of 6 touch drags, 4 devices, ar and en). For TOUCH pointers only: swallow the
+ * pointerdown, and replay it as a mouse-type pointerdown when the finger lifts without having moved (a tap). Two details,
+ * both measured: (1) the real pointerdown is cancelled, as the compiled picker did, so the browser's compatibility mouse
+ * events stay suppressed; (2) the tap's own click is still delivered to whatever lies under the finger once the list has
+ * closed, which was the street / building field for some rows (5 of 14 taps moved the focus there and opened the keyboard
+ * on the wrong field), so that one click is swallowed and the focus kept on the area field (0 of 15 taps afterwards).
+ * Mouse, pen and keyboard are untouched; touch-action is not changed, so the browser still scrolls the list. */
+;(function () {
+  'use strict'
+  if (typeof PointerEvent === 'undefined') return
+  var st = null
+  var SEL = '[role="listbox"] [role="option"]'
+  document.addEventListener('pointerdown', function (e) {
+    if (e.__sporta || e.pointerType !== 'touch' || !e.target.closest) return
+    var li = e.target.closest(SEL)
+    if (!li) return
+    var ul = li.closest('[role="listbox"]')
+    st = { id: e.pointerId, x: e.clientX, y: e.clientY, li: li, field: ul && ul.parentElement && ul.parentElement.querySelector('input') }
+    e.preventDefault()
+    e.stopImmediatePropagation()
+  }, true)
+  document.addEventListener('pointercancel', function (e) { if (st && e.pointerId === st.id) st = null }, true)
+  document.addEventListener('pointerup', function (e) {
+    if (!st || e.pointerId !== st.id) return
+    var s = st
+    st = null
+    if (Math.abs(e.clientX - s.x) > 8 || Math.abs(e.clientY - s.y) > 8) return
+    var ev = new PointerEvent('pointerdown', { bubbles: true, cancelable: true, pointerType: 'mouse', clientX: e.clientX, clientY: e.clientY })
+    ev.__sporta = true
+    s.li.dispatchEvent(ev)
+    var done = function () { document.removeEventListener('click', onClick, true); clearTimeout(timer) }
+    var onClick = function (c) {
+      c.preventDefault()
+      c.stopPropagation()
+      done()
+      if (s.field && s.field.isConnected && document.activeElement !== s.field) s.field.focus({ preventScroll: true })
+    }
+    var timer = setTimeout(done, 700)
+    document.addEventListener('click', onClick, true)
+  }, true)
+})()
