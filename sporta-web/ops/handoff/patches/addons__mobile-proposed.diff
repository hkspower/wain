   if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start, { once: true }); else start()
 })()
 /* ===== ADMIN ABANDONED ORDERS - end ======================================= */
+
+/* ===== MC-05 = M3-02 : ORDER SHEET, THE OWNER'S PHONE ====================================================================
+ * Orders > open an order. The delivery Note is a single-line <input maxlength=280>, 44 px high: a 123-character Arabic
+ * note showed 40-42% of its text at 320/360/390 and the visible part was the END of it (the start, "call before arriving",
+ * was hidden); the checkout's share-location line "Location: https://www.google.com/maps?q=LAT,LNG" showed 73-76%, so the
+ * coordinates were cut off. There was no tel: link anywhere in the sheet (the phone is only an editable field) and no map
+ * link: the owner had to select a URL inside a field to open a pin, and could not tap to call a cash-on-delivery customer.
+ * Under the Note this adds (1) Call (tel:), (2) Open location, only when the note holds that exact line, and (3) the whole
+ * note as plain wrapping text that can be read without swiping sideways. Built with textContent / setAttribute only; the
+ * map URL is REBUILT from two validated numbers, never copied from the note; the tel: number is digits only. Nothing is
+ * sent anywhere and no React-owned node is changed: the added nodes are siblings and are rebuilt when the order or the
+ * phone/note text changes. */
+;(function () {
+  'use strict'
+  if (location.pathname.indexOf('/backends') !== 0) return
+  var MARK = 'data-sporta-owner-quick'
+  var LOC = /(?:Location|الموقع):\s*https:\/\/www\.google\.com\/maps\?q=(-?\d{1,3}(?:\.\d+)?),(-?\d{1,3}(?:\.\d+)?)/
+
+  function labelFor(dlg, word) {
+    var ls = dlg.querySelectorAll('label')
+    for (var i = 0; i < ls.length; i++) if (ls[i].textContent.replace(/\s+/g, ' ').trim().indexOf(word) === 0) return ls[i]
+    return null
+  }
+  function telDigits(v) {
+    var d = String(v || '').replace(/\D/g, '')
+    if (d.indexOf('00') === 0) d = d.slice(2)
+    if (d.length === 8) d = '965' + d
+    return d.length >= 8 && d.length <= 15 ? d : ''
+  }
+  function mkLink(wa, href, text, ext) {
+    var a = document.createElement('a')
+    a.setAttribute('href', href)
+    a.textContent = text
+    if (ext) { a.setAttribute('target', '_blank'); a.setAttribute('rel', 'noopener noreferrer') }
+    if (wa && wa.className) a.className = wa.className
+    else a.style.cssText = 'display:inline-flex;align-items:center;justify-content:center;border:1px solid #cbd5e1;border-radius:.75rem;padding:0 .9rem;font-weight:700;text-decoration:none'
+    a.style.minHeight = '44px'
+    return a
+  }
+  function enhance(dlg) {
+    var noteL = labelFor(dlg, 'Note'), phoneL = labelFor(dlg, 'Phone')
+    if (!noteL || !phoneL) return
+    var ni = noteL.querySelector('input'), pi = phoneL.querySelector('input')
+    if (!ni || !pi) return
+    var key = pi.value + '\u0001' + ni.value
+    var wrap = dlg.querySelector('[' + MARK + ']')
+    if (wrap && wrap.getAttribute(MARK) === key) return
+    if (wrap) wrap.remove()
+    wrap = document.createElement('div')
+    wrap.setAttribute(MARK, key)
+    wrap.style.cssText = 'display:flex;flex-wrap:wrap;gap:.5rem;align-items:center'
+    var wa = dlg.querySelector('a[href*="wa.me"]')
+    var digits = telDigits(pi.value)
+    if (digits) wrap.appendChild(mkLink(wa, 'tel:+' + digits, 'Call', false))
+    var m = LOC.exec(ni.value)
+    if (m && Math.abs(+m[1]) <= 90 && Math.abs(+m[2]) <= 180) wrap.appendChild(mkLink(wa, 'https://www.google.com/maps?q=' + (+m[1]) + ',' + (+m[2]), 'Open location', true))
+    if (ni.value) {
+      var p = document.createElement('p')
+      p.setAttribute('dir', 'auto')
+      p.style.cssText = 'flex-basis:100%;margin:0;font-size:14px;line-height:1.5;white-space:pre-wrap;overflow-wrap:anywhere;user-select:text'
+      p.textContent = ni.value
+      wrap.appendChild(p)
+    }
+    noteL.insertAdjacentElement('afterend', wrap)
+  }
+  var queued = false
+  function scan() {
+    queued = false
+    var dlg = document.querySelector('[role="dialog"][aria-label^="Order"]')
+    if (dlg) { try { enhance(dlg) } catch (e) { /* never break the admin */ } }
+  }
+  function schedule() { if (!queued) { queued = true; requestAnimationFrame(scan) } }
+  function start() {
+    schedule()
+    new MutationObserver(schedule).observe(document.body, { childList: true, subtree: true })
+    document.addEventListener('input', schedule, true)
+  }
+  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start, { once: true }); else start()
+})()
+/* ===== MC-05 - end ======================================================================================================= */
