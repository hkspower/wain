+++ b/sporta-web/src/admin/useDesktop.js
@@ -0,0 +1,19 @@
+import { useSyncExternalStore } from 'react'
+
+// True from 768px up — the same breakpoint admin-mobile.css uses to hide `.m-list`
+// and show `.admin-table` (and the reverse below it). The admin screens used to
+// render BOTH the table and the phone list for every row and let CSS hide one,
+// so each screen paid for two copies of every row (and, in Inventory, two live
+// StockCell inputs per variant). Rendering only the visible one halves the work;
+// the CSS rules stay as they are and still apply.
+const QUERY = '(min-width: 768px)'
+
+function subscribe(onChange) {
+  const m = window.matchMedia(QUERY)
+  m.addEventListener('change', onChange)
+  return () => m.removeEventListener('change', onChange)
+}
+
+export function useDesktop() {
+  return useSyncExternalStore(subscribe, () => window.matchMedia(QUERY).matches, () => true)
+}
