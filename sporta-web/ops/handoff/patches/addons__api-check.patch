+/* ===========================================================================
+ * API call discipline [F-02 duplicate asks, F-05 late start, M-01 admin edits stay visible] (API check 2026-11-04).
+ *
+ * The compiled storefront asks /api for the same shop-window JSON from several
+ * places at once and again on every tab switch, and /api is `no-store`, so each
+ * ask is a real round trip: measured on the mirror of the live bundle
+ *   - /product/<slug>: ?r=stock twice (this file's size loader AND the bundle),
+ *   - /checkout:       ?r=checkout_config twice (footer AND page),
+ *   - bag not empty:   ?r=products again on the first add-to-bag and on EVERY
+ *                      visibilitychange to "visible" (each tab switch),
+ *   - every hard load: all calls start only after the 165 kB bundle has run
+ *                      (~0.7 s on a desktop, seconds on a phone).
+ * None of that needs a rebuild. This wrapper sits in front of window.fetch for
+ * exactly six same-origin GET routes whose answer is identical for every
+ * visitor, and does three things:
+ *   1. COALESCE  concurrent identical asks share one request;
+ *   2. REMEMBER  a successful answer is reused for a short time (TTL below, in
+ *                memory only: a reload or any hard navigation starts clean, so
+ *                the post-order page never sees an older catalogue);
+ *   3. START EARLY the routes this path will need begin NOW, in <head>, instead
+ *                of after the bundle has downloaded and run.
+ * Everything else (POSTs, admin.php, customer.php, ?r=status/invoice, images)
+ * passes through untouched, and any problem inside the wrapper falls back to
+ * the real fetch. Caller semantics kept: ok/status/JSON body, and an aborted
+ * signal still rejects with AbortError for that caller only.
+ * Prices and stock are only DISPLAYED from this data; the order route re-prices
+ * and re-checks stock on the server, so a TTL of 30 s cannot change a charge.
+ * ========================================================================= */
+;(function () {
+  'use strict'
+  try {
+    if (!window.fetch || !window.Promise || !window.URL || !window.Response) return
+    var API = '/api/api.php'
+    var TTL = { products: 30000, stock: 30000, slides: 60000, brands: 60000, theme: 60000, checkout_config: 60000 }
+    var cache = {}, flight = {}
+    var real = window.fetch.bind(window)
+    function route(input, init) {
+      try {
+        var method = String((init && init.method) || (input && typeof input === 'object' && input.method) || 'GET').toUpperCase()
+        if (method !== 'GET') return ''
+        var u = new URL(typeof input === 'string' ? input : (input && input.url) || '', location.href)
+        if (u.origin !== location.origin || u.pathname !== API) return ''
+        var keys = []; u.searchParams.forEach(function (v, k) { keys.push(k) })
+        if (keys.length !== 1 || keys[0] !== 'r') return ''
+        var r = u.searchParams.get('r')
+        return TTL[r] ? r : ''
+      } catch (e) { return '' }
+    }
+    function abortError() { try { return new DOMException('The operation was aborted.', 'AbortError') } catch (e) { var x = new Error('aborted'); x.name = 'AbortError'; return x } }
+    function answer(rec) { return new Response(rec.body, { status: rec.status, statusText: rec.statusText, headers: { 'Content-Type': rec.ct } }) }
+    function guard(p, init) {
+      var s = init && init.signal
+      if (!s) return p
+      if (s.aborted) return Promise.reject(abortError())
+      return new Promise(function (res, rej) { s.addEventListener('abort', function () { rej(abortError()) }, { once: true }); p.then(res, rej) })
+    }
+    function ask(r) {
+      var hit = cache[r]
+      if (hit && Date.now() - hit.at < TTL[r]) return Promise.resolve(hit)
+      if (flight[r]) return flight[r]
+      var opts = { credentials: 'same-origin' }
+      try { if (window.AbortSignal && AbortSignal.timeout) opts.signal = AbortSignal.timeout(25000) } catch (e) {}
+      flight[r] = real(API + '?r=' + r, opts).then(function (res) {
+        return res.text().then(function (body) {
+          var rec = { at: Date.now(), status: res.status, statusText: res.statusText, ct: res.headers.get('content-type') || 'application/json', body: body }
+          // Remembered only if it is a 2xx that really is JSON: an HTML page with a 200 (a proxy error page, a captive
+          // portal) or a truncated body is handed to the callers that are already waiting, but never kept.
+          var good = res.ok
+          if (good) { try { JSON.parse(body) } catch (e) { good = false } }
+          if (good) cache[r] = rec
+          return rec
+        })
+      }).then(function (rec) { delete flight[r]; return rec }, function (err) { delete flight[r]; throw err })
+      return flight[r]
+    }
+    // ADMIN SAFETY (verifier refinement): the owner's own edits must show at once. After any call to
+    // admin.php in this page's lifetime (the /backends screens, and a storefront opened from them by in-app
+    // navigation) the shop-window routes are asked live and nothing is kept. The Theme editor also announces a
+    // saved theme with 'sporta:theme-updated' and re-reads r=theme: drop the kept copy on that event.
+    var admin = /^\/backends(\/|$)/.test(location.pathname)
+    function isAdminCall(input) {
+      try { var u = new URL(typeof input === 'string' ? input : (input && input.url) || '', location.href); return u.origin === location.origin && u.pathname === '/api/admin.php' } catch (e) { return false }
+    }
+    try { window.addEventListener('sporta:theme-updated', function () { delete cache.theme; delete flight.theme }) } catch (e) {}
+    window.fetch = function (input, init) {
+      if (!admin && isAdminCall(input)) { admin = true; cache = {} }
+      var r = route(input, init)
+      if (!r || admin) return real(input, init)
+      return guard(ask(r).then(answer), init)
+    }
+    // What each path is known to need (measured census, A1). A route that is started and then not used costs one small GET.
+    var p = location.pathname, early
+    if (/^\/backends(\/|$)/.test(p)) early = []
+    else if (p === '/') early = ['slides', 'brands', 'stock', 'products', 'checkout_config', 'theme']
+    else if (/^\/(shop|cart|checkout|wishlist)$|^\/product\//.test(p)) early = ['theme', 'slides', 'stock', 'products', 'checkout_config']
+    else early = ['theme', 'slides', 'checkout_config']
+    early.forEach(function (r) { ask(r).catch(function () {}) })
+  } catch (e) { /* never block the page */ }
+})()
