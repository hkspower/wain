+/* ===========================================================================
+ * POST deadlines [F-09 / A2-F07] (API check 2026-11-04; money path, so it needs the
+ * same review gate as any order-route change).
+ *
+ * The compiled checkout calls fetch() for ?r=order and ?r=discount WITHOUT any
+ * timeout or signal. If the answer never comes (a proxy that holds the socket
+ * open, a PHP worker stuck behind the mail relay) the button stays disabled on
+ * "Redirecting to payment…" for ever: no message, no way out but a reload, and
+ * on a phone that looks like a frozen shop at the exact moment of paying.
+ * A deadline turns that into the existing "failed" path: the shopper is told it
+ * did not go through and can press the button again. That is safe for the order
+ * because the browser keeps ONE client-generated track id per attempt
+ * (sessionStorage sporta.checkout.attempt) and the server creates the order
+ * idempotently on it: asking again returns the same order, and a changed form
+ * hits the existing "previous order may exist" warning with a track link.
+ * Only POSTs that pass no signal of their own are touched.
+ * ========================================================================= */
+;(function () {
+  'use strict'
+  try {
+    if (!window.fetch || !window.AbortSignal || !AbortSignal.timeout) return
+    var inner = window.fetch
+    var DEADLINE = { order: 40000, discount: 25000, assistant: 40000 }
+    window.fetch = function (input, init) {
+      try {
+        var method = String((init && init.method) || (input && typeof input === 'object' && input.method) || 'GET').toUpperCase()
+        if (method === 'POST' && !(init && init.signal)) {
+          var u = new URL(typeof input === 'string' ? input : (input && input.url) || '', location.href)
+          var ms = u.origin === location.origin && u.pathname === '/api/api.php' ? DEADLINE[u.searchParams.get('r')] : 0
+          if (ms) init = Object.assign({}, init || {}, { signal: AbortSignal.timeout(ms) })
+        }
+      } catch (e) { /* fall through to the untouched call */ }
+      return inner(input, init)
+    }
+  } catch (e) { /* never block the page */ }
+})()
+
+/* ===========================================================================
+ * Honest errors for the two "look up my order" routes [F-06] (API check 2026-11-04).
+ *
+ * The compiled API client turns EVERY non-2xx answer into `null` ("no such thing"). For
+ * ?r=status and ?r=invoice that is wrong: the server already says "unknown order" as
+ * 200 + `null` (api.php: `if (!$row) store_out(null)`), so a 429 from the 60/minute limiter or a
+ * 500/502/503 from a restart is NOT "no such order" — yet the track page and the invoice page both
+ * say "No order with this number". A shopper whose order exists is told it does not.
+ * The pages already have the right wording for "could not check, try again": they show it when the
+ * request itself FAILS (offline, unreadable body). So make a 5xx or 429 on these two GETs look like
+ * that, and nothing else changes: 200, 404 and every other route pass through.
+ * NOT covered: ?r=review_invite — the review page shows "link not valid" for ANY failure, offline
+ * included, so it needs the rebuilt page (F-07); /payment/result swallows every failure by design
+ * of its own code (F-08), also rebuild.
+ * ========================================================================= */
+;(function () {
+  'use strict'
+  try {
+    if (!window.fetch || !window.URL) return
+    var inner = window.fetch
+    var ROUTES = { status: 1, invoice: 1 }
+    window.fetch = function (input, init) {
+      var p = inner(input, init)
+      try {
+        var method = String((init && init.method) || (input && typeof input === 'object' && input.method) || 'GET').toUpperCase()
+        var u = new URL(typeof input === 'string' ? input : (input && input.url) || '', location.href)
+        if (method === 'GET' && u.origin === location.origin && u.pathname === '/api/api.php' && ROUTES[u.searchParams.get('r')]) {
+          return p.then(function (res) { if (res.status >= 500 || res.status === 429) throw new TypeError('Failed to fetch'); return res })
+        }
+      } catch (e) { /* untouched call */ }
+      return p
+    }
+  } catch (e) { /* never block the page */ }
+})()
