+}
# sporta-web/public/sporta-brand-theme.css : F2-06 F2-03 F2-07(optional) F2-18 F3-02/F2-15
diff --git a/sporta-web/public/sporta-brand-theme.css b/sporta-web/public/sporta-brand-theme.css
index cb6c010..63cb900 100644
--- a/sporta-web/public/sporta-brand-theme.css
+++ b/sporta-web/public/sporta-brand-theme.css
@@ -82,3 +82,49 @@ F2-06 F2-03 F2-07(optional) F2-18 F3-02/F2-15
 .storefront-root :is(input, select, textarea):focus-visible {
   box-shadow: 0 0 0 3px rgba(224, 86, 28, 0.22);
 }
+
+/* [F2-06] The Support page title (h1.page-heading with no font-* class) falls to the body weight, 400, while every
+ * other page title is 800-900. Only an h1 that carries no font-* utility is touched, so Cart/Checkout (800) and the
+ * titles that already say font-black keep their own weight. */
+h1.page-heading:not([class*="font-"]) {
+  font-weight: 900;
+}
+
+/* [F2-03] Arabic gets one size step more everywhere else (13px small text), but the phone nav row has its own media
+ * rule with no RTL twin: 12px at 320-390. 13px at 320/360, 13.3px at 390, 14px at 430; labels stay on one line.
+ * :where() keeps the specificity at the bundle's own (0,3,0), so this wins over it by source order (add-ons load after
+ * the app stylesheet) but a later, more specific nav rule such as sporta-bag-touch.css [menu-4] (14px, undeployed
+ * sizes lane) still wins over this one instead of being cut back to 13px. */
+@media (max-width: 639px) {
+  :where([dir="rtl"]) .storefront-root .navbar-secondary .navbar-link {
+    font-size: clamp(0.8125rem, 3.4vw, 0.875rem);
+  }
+}
+
+/* [F2-07, optional] Long-form paragraphs run 105-161 Arabic / 99-137 English characters per line on About FAQ, Terms,
+ * Privacy and Support at 1280+. 34rem gives 70-92 characters. Trade-offs, both measured: the section dividers keep
+ * their full width, so the text hugs the start edge of a wider rule, and Terms is 10-14% taller at 1280 (+343 px Arabic,
+ * +501 px English). Drop this block if the owner prefers the wide column. */
+.editorial-page :is(p, li),
+.faq-list p,
+.legal-page__section :is(p, li),
+.legal-page__intro {
+  max-width: 34rem;
+}
+
+/* [F2-18] The English promo bar is 11px at 320-639 (Arabic 12px). 12px fits from 360 px; at 320 it would truncate, so
+ * 320 is left alone. */
+@media (min-width: 360px) and (max-width: 639px) {
+  html:lang(en) .topbar {
+    font-size: 0.75rem;
+  }
+}
+
+/* [F3-02, same cause as F2-15] From 640 px the promo bar text is line-height 1 inside overflow:hidden (truncate),
+ * which cuts the Arabic descender tails by 1.7-2.3 css px. A 1.5 line box is clipped nowhere; the bar is h-8 with
+ * items-center, so its height does not move. */
+@media (min-width: 640px) {
+  .topbar .truncate {
+    line-height: 1.5;
+  }
+}
# sporta-web/public/sporta-cart-drawer.css : F3-06
