# fonts-proposed.diff - proposed fixes from the fonts audit of 2026-11-03. NOT applied to the repo, nothing deployed.
# Base: git HEAD a98dc9c9 of /home/user/wain (proven on 64caea72; the seven files are byte-identical in both). Apply from the repo root:  git apply fonts-proposed.diff
# Add-on files only (no .htaccess change is needed). Every added block starts with a comment naming its finding id;
# the trailing text of each hunk header repeats the ids. Report: sporta-web/FONTS-AUDIT-2026-11-03.md

# sporta-web/public/boot.js : F1-01 (English only)
diff --git a/sporta-web/public/boot.js b/sporta-web/public/boot.js
index baa6b1f..babda3b 100644
--- a/sporta-web/public/boot.js
+++ b/sporta-web/public/boot.js
@@ -76,6 +76,25 @@ F1-01 (English only)
       document.head.appendChild(preload)
     })
 
+    // [F1-01] English: the top bar, nav, buttons and prices draw in Plex 600/700, which the page only asks for after
+    // the first layout, so on a first visit over a slow link they sit in a system font for about a second and then
+    // change typeface. Same two Latin files the page fetches anyway (about 40 kB, no extra bytes), preloaded at LOW
+    // priority so they do not compete with the hero or delay the first text (default priority moved it 0.5 s later).
+    // Arabic (the default language) is NOT changed here: the same idea costs the Arabic first text 0.4-0.95 s at
+    // 1.6 Mbps unless the four Arabic font files are re-subset first (finding F1-05).
+    if (!ar) {
+      ;['plex-700-latin', 'plex-600-latin'].forEach(function (font) {
+        var late = document.createElement('link')
+        late.rel = 'preload'
+        late.as = 'font'
+        late.type = 'font/woff2'
+        late.crossOrigin = 'anonymous'
+        late.setAttribute('fetchpriority', 'low')
+        late.href = '/fonts/' + font + '.woff2'
+        document.head.appendChild(late)
+      })
+    }
+
   } catch (_) {
     // Private browsing can reject localStorage. Defaults in the HTML remain safe.
   }
# sporta-web/public/sporta-admin-knet.css : F3-13
