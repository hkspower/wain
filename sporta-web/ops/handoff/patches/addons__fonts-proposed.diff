+}
# sporta-web/public/sporta-checkout-a11y.css : F2-02 F2-04 F2-14/F3-10 F2-17 F3-08
diff --git a/sporta-web/public/sporta-checkout-a11y.css b/sporta-web/public/sporta-checkout-a11y.css
index a3a7cfd..a634e33 100644
--- a/sporta-web/public/sporta-checkout-a11y.css
+++ b/sporta-web/public/sporta-checkout-a11y.css
@@ -220,3 +220,38 @@ F2-02 F2-04 F2-14/F3-10 F2-17 F3-08
 .storefront-root .purchase-flow > h1,
 .storefront-root .purchase-flow .purchase-heading h1 { font-size: clamp(1.5rem, 2.4vw, 2rem); }
 .storefront-root .purchase-flow > h1 { margin-block: 1rem .5rem !important; }
+
+/* [F2-02] The saved-address card shows the shopper's optional order note with Tailwind .italic. Plex has no italic
+ * face, so Chrome slants the Arabic itself (synthetic). Arabic has no italic; the quotation marks already mark it. */
+.storefront-root .italic {
+  font-style: normal;
+}
+
+/* [F2-04] The progress-step labels are hard-coded to 11px at 379 px and under, so Arabic misses its extra step.
+ * 12px keeps each label on one line (26-40 px wide). */
+@media (max-width: 379px) {
+  [dir="rtl"] .purchase-steps__body > span:last-child {
+    font-size: 0.75rem;
+  }
+}
+
+/* [F2-14 / F3-10] Short Arabic paragraphs at line-height 1.38-1.43 (Plex Arabic's own content area is 1.5em). Not the
+ * display headings and card names, which are deliberate. The footer legal lines (13px / 1.33) are left out of this
+ * patch; add "footer p.text-xs" to the list to include them (+9 px page height). */
+[dir="rtl"] :is(p.purchase-notice, p.guest-note__body) {
+  line-height: 1.65;
+}
+
+/* [F2-17] The grand total (and its "calculating" text) has letter-spacing -0.025em with no RTL twin; every other
+ * tracking class is reset for Arabic. Arabic joins must not be tracked either way. */
+[dir="rtl"] .purchase-checkout-summary .purchase-total .text-accent {
+  letter-spacing: 0;
+}
+
+/* [F3-08] The phone pay bar total is overflow:hidden (truncate) in a 28px line box: the kasratan under the ra of the
+ * Arabic "calculating total" text is cut 3.7 px. Padding and a matching negative margin free the ink without moving
+ * the bar. */
+.purchase-paybar p.truncate {
+  padding-block-end: 0.3em;
+  margin-block-end: -0.3em;
+}
# sporta-web/public/sporta-grid.css : F2-01
diff --git a/sporta-web/public/sporta-grid.css b/sporta-web/public/sporta-grid.css
index 6369d17..ef52615 100644
--- a/sporta-web/public/sporta-grid.css
+++ b/sporta-web/public/sporta-grid.css
@@ -84,3 +84,23 @@ F2-01
   clip-path: inset(50%) !important;
   white-space: nowrap !important;
 }
+
+/* [F2-01] Sold-out band, its white fade and the Bestseller badge are position:absolute with z-index:auto, so the
+ * product photo (img.catalog-card-photo, relative z-[1]) paints OVER them: hiding them changed 0 px. Lift them above
+ * the photo (z 2; the wishlist heart stays above at z 10). The image-loading skeleton is left alone. */
+.catalog-card-image > a > span.absolute:not(.image-loading-skeleton) {
+  z-index: 2;
+}
+/* [F2-01] Once painted, the English badge ("Bestseller") is wider than its pill at 320-360 px: clip it with an
+ * ellipsis rather than overflow (at 320 it needs 69 px and has 50, so it still clips there). Arabic wraps to two
+ * lines and fits, so it keeps wrapping. */
+html:lang(en) .catalog-card-badge {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+@media (max-width: 479px) {
+  .catalog-card-badge {
+    padding-inline: 0.25rem;
+  }
+}
# sporta-web/public/sporta-product-fix.css : F3-01 F3-10 F3-09
diff --git a/sporta-web/public/sporta-product-fix.css b/sporta-web/public/sporta-product-fix.css
index fe23de0..12d3ca8 100644
--- a/sporta-web/public/sporta-product-fix.css
+++ b/sporta-web/public/sporta-product-fix.css
@@ -172,3 +172,21 @@ F3-01 F3-10 F3-09
 .catalog-product-page .product-purchase-row {
   margin-top: 1rem;
 }
+
+/* [F3-01] The Sporta AI panel is a DOM child of .navbar-tools > .navbar-main, which the bundle sets to direction:ltr,
+ * so on an Arabic page the reply bubble hugs the left edge and the closing full stop lands at the wrong end of every
+ * Arabic sentence. RTL on the panel's CHILDREN only: the panel box (end-4 anchor) does not move. English untouched. */
+html[dir="rtl"] .navbar-tools div[role="dialog"] > * {
+  direction: rtl;
+}
+
+/* [F3-10] The AI chat bubble is Arabic text at line-height 1.43 (2+ lines). Same body-text rule as the checkout notes. */
+[dir="rtl"] .navbar-tools div[role="dialog"] div.inline-block {
+  line-height: 1.65;
+}
+
+/* [F3-09] The invoice discount cell is td[dir=ltr]: on an Arabic invoice the minus ends up on the far side of the
+ * currency, detached from the figure. RTL puts it next to the number; English keeps its own order. */
+html[dir="rtl"] .invoice tfoot td[dir="ltr"] {
+  direction: rtl;
+}
