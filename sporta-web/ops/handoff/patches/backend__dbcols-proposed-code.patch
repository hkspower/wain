 }
 
+// store_opt() with a ceiling. Same trim, same empty-is-null, same control characters kept (a slide's subtitle may hold a
+// line break; store_checkout_optional() would strip it and glue the words), but a value longer than $max is refused with a
+// named token instead of being cut at 280 and then failing in the INSERT on a column that is narrower (HTTP 500 'failed'
+// under a strict sql_mode, a silent cut under a lax one).
+function store_opt_max(mixed $v, string $field, int $max): ?string {
+    $t = trim(store_input_string($v, 'text'));
+    if ($t === '') return null;
+    if (mb_strlen($t) > $max) store_fail("too_long_{$field}");
+    return $t;
+}
