+  # pay.php is a page whose only job is to POST a form to the CBK gateway, and it starts
+  # that POST from <body onload="document.forms[0].submit()">. The storefront policy it
+  # inherits has no 'unsafe-inline' (so Chrome refuses the handler: measured, title stays
+  # unchanged, "Executing inline event handler violates ... Content Security Policy") and
+  # its form-action lists only KNET's hosts (so the POST would be refused next). With the
+  # CBK path switched on the customer would sit on "Redirecting..." for ever.
+  #
+  # This page gets its own, narrower policy: no scripts at all except that one attribute,
+  # allowed by hash ('unsafe-hashes' + script-src-attr, CSP3: Chrome 75+, Firefox 106+,
+  # Safari 15.4+), and a form-action that names the gateway. 'self' stays in form-action
+  # because Chrome applies it to the gateway's redirect back to /pay/callback.php too.
+  # Hosts are the two in config.example.php; compare them with the live pay-config.php
+  # before shipping. The durable fix is an external script file (no hash to maintain).
+  # Inside a <FilesMatch> so it lands in the same merge stage as, and replaces, the policy
+  # inherited from the storefront file.
+  <FilesMatch "^pay\.php$">
+    Header set Content-Security-Policy "default-src 'none'; base-uri 'none'; frame-ancestors 'self'; style-src 'unsafe-inline'; script-src 'none'; script-src-attr 'unsafe-hashes' 'sha256-ePniVEkSivX/c7XWBGafqh8tSpiRrKiqYeqbG7N1TOE='; form-action 'self' https://pg.cbk.com https://pgtest.cbk.com"
+  </FilesMatch>
