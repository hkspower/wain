# alignment-proposed.diff - proposed fixes from the page-alignment audit of 2026-11-03. NOT applied to the repo, nothing deployed.
# Base: git HEAD 3776a4ae of /home/user/wain. Apply from the repo root:  git apply alignment-proposed.diff   (check first: git apply --check)
# Add-on files only (no .htaccess change is needed). Every hunk is a pure append at the end of its file; every added block starts
# with a comment naming its finding id, and the trailing text of each hunk header repeats the ids. Report: sporta-web/ALIGNMENT-AUDIT-2026-11-03.md
# A-23 is OPTIONAL (owner decision, bag drawer side in Arabic). A-02, A-03, A-07 and A-28 are the same fixes as F2-01, F3-01, F3-06 and F2-17 in
# fonts-proposed.diff: if both patches are used, ship each rule once (they append to the same files, so apply by hand or drop the duplicate blocks).
# DEPLOY NOTE: the live add-on files are NOT HEAD's (HEAD carries unreviewed sizes-lane work). Ship only the added blocks, appended to the files as
# they are live today, never HEAD's whole files. The proof (report section 4) runs the blocks on both the live copies and the HEAD copies.
# sporta-web/public/sporta-home-trim.css : A-04 A-11 A-15 A-18
diff --git a/sporta-web/public/sporta-home-trim.css b/sporta-web/public/sporta-home-trim.css
index 70da9eb..056f9a1 100644
--- a/sporta-web/public/sporta-home-trim.css
+++ b/sporta-web/public/sporta-home-trim.css
@@ -125,3 +125,46 @@ A-04 A-11 A-15 A-18
 [dir="rtl"] .storefront-root .editorial-page:has(.why-card-index) .why-card h3 {
   font-family: "Sporta About Digits Display", var(--sporta-font-display-ar, "Sporta Alexandria Local"), "Alexandria Fallback", "Sporta Plex Arabic Local", "Plex Arabic Fallback", "alexandria", "ibm-plex-arabic", system-ui, sans-serif;
 }
+
+/* [A-04] Hero previous/next arrows sit on the headline from 1024 to 1439 px. The arrows are 46 px round buttons
+ * (md:start-5 / md:end-5, vertically centred, always visible); the copy starts at the page gutter, which is 31 px at
+ * 1024, 38 px at 1280 and 47 px at 1366, so the arrow (x 21-67) covers the first letters of the headline: overlap
+ * 36 px at 1024, 29 at 1280, 21 at 1366, 4 at 1400, none below 1000 or from 1440 (gutter 83 px and up). Padding on
+ * BOTH sides because the copy-end slides put their text under the other arrow. */
+@media (min-width: 1024px) and (max-width: 1439.98px) {
+  .campaign-home .campaign-photo-hero .campaign-hero-content {
+    padding-inline: 5rem;
+  }
+}
+
+/* [A-11] The footer join band is a flex row with justify-content:space-between from 768 px. sporta-footer-call.js adds
+ * a THIRD child (the call button) next to the compiled copy + WhatsApp button, so the two buttons are thrown apart:
+ * 82 px (Arabic) / 48 px (English) at 768, 314 / 279 px at 1280, 347 / 311 px at 1536. Buttons stay together at the
+ * end, the copy keeps the start edge. Below 768 the band is already stacked and centred. */
+@media (min-width: 768px) {
+  .storefront-root footer .footer-club {
+    justify-content: flex-start;
+    gap: .75rem;
+  }
+  .storefront-root footer .footer-club > div {
+    margin-inline-end: auto;
+  }
+}
+
+/* [A-15] The sticky brand strip sticks at 9.75rem (161.5 px at 1024, 164 px at 1280, 166 px at 1536) but the header ends at
+ * 8.62rem (142.8 / 145 / 146.5 px): a constant 19 px band between the two sticky bars in which the tiles and photos scroll
+ * through. The header has no height variable, so this is the measured number: if the top bar is ever switched off (about
+ * 32 px less), lower it by 2rem. */
+@media (min-width: 1024px) {
+  .campaign-brand-bar {
+    top: 8.6rem;
+  }
+}
+
+/* [A-18] The hero's dot strip is 338 px wide (7 dots x 40 px hit boxes + the 40 px pause button), centred on a 320 px
+ * screen: the outer dot and the pause button are cut by 9 px each side. 36 px boxes fit (strip 310 px). */
+@media (max-width: 339.98px) {
+  main div.absolute.bottom-5 > button.group\/dot {
+    min-width: 2.25rem;
+  }
+}

