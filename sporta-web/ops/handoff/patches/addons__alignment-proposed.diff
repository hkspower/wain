@@ -101,3 +101,45 @@ A-05 A-22 A-14 A-16
 
 /* [sizes-edit-3] */
 .storefront-root .editorial-page .faq-list details { padding-block: .75rem; }
+
+/* [A-05] Order tracking progress bar in Arabic: the connector line between two steps is -translate-x-1/2 with no rtl
+ * twin, so it is shifted toward the NEXT step instead of the previous one: no line between the first two circles, an
+ * orange line leading into a step that is not reached, and a grey stub that leaves the card (card edge -1 at 390 px) and
+ * makes the page pan sideways (scrollWidth 391 at 390, 436 at 430, 797 at 768). Tailwind 4 reads the translate from
+ * this variable. English is correct and untouched. */
+:root[dir="rtl"] .track-progress > li > span.absolute {
+  --tw-translate-x: 50%;
+}
+
+/* [A-22] /track order-number field: the input is dir="ltr" (right for a Latin order id) but its placeholder is Arabic
+ * ("مثال: SP1A2B3C"), so the colon lands on the wrong side of the Arabic word. While the placeholder shows, lay the input
+ * out right-to-left; once something is typed it is ltr again, so keep the typed id at the same (right) edge. The
+ * checkout phone field is not in .tracking-panel and is not touched. */
