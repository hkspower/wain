+  .invoice-table {
+    min-width: 0 !important;
+    table-layout: auto !important;
+  }
+  .invoice-table th,
+  .invoice-table td {
+    padding-inline: .25rem !important;
+    white-space: normal !important;
+  }
+}

# sporta-web/public/sporta-features.js : A-01
diff --git a/sporta-web/public/sporta-features.js b/sporta-web/public/sporta-features.js
index 1d6f900..fb75e0b 100644
--- a/sporta-web/public/sporta-features.js
+++ b/sporta-web/public/sporta-features.js
@@ -1096,3 +1096,41 @@ A-01
     else start()
   } catch (e) {}
 })()
+
+/* [A-01] The Arabic delivery line "التوصيل خلال ٢٤ ساعة · ١ د.ك" (product page list, About "why" card) has a middle dot (U+00B7)
+ * directly before the Arabic-Indic digit one. In a right-to-left line the dot sits at mid height right of the 1, and a
+ * 3x crop reads "٢٤ ساعة ١٠ د.ك": the 1 KWD fee reads as 10 KWD. The repo's own top-bar copy already writes it with "بـ"
+ * ("خلال ٢٤ ساعة بـ ١ د.ك"). Text nodes only (nodeValue), nothing added or removed, so React's tree is untouched; a re-render
+ * that rewrites the node is answered by writing it again. The bundle's default top-bar line, shown for a moment before the owner's
+ * message arrives, has the same dot after "داخل الكويت", so "الكويت" is matched too. Arabic only; the English line reads correctly. Permanent fix at
+ * the next storefront rebuild: src/i18n/translations.js (the delivery line) and the live bundle's string. */
+;(function () {
+  'use strict'
+  var RE = /(ساعة|الكويت)\s*[·•]\s*([٠-٩]+\s*د\.ك)/g
+  function isAr() { return (document.documentElement.lang || 'ar').slice(0, 2) !== 'en' }
+  function fix() {
+    if (!isAr() || !document.body) return
+    var w = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, null)
+    var n
+    while ((n = w.nextNode())) {
+      var v = n.nodeValue
+      if (v && v.indexOf('·') > -1 && v.indexOf('د.ك') > -1) {
+        var t = v.replace(RE, '$1 بـ $2')
+        if (t !== v) n.nodeValue = t
+      }
+    }
+  }
+  var queued = false
+  function schedule() {
+    if (queued) return
+    queued = true
+    requestAnimationFrame(function () { queued = false; try { fix() } catch (e) {} })
+  }
+  function start() {
+    schedule()
+    new MutationObserver(schedule).observe(document.body, { childList: true, subtree: true, characterData: true })
+    new MutationObserver(schedule).observe(document.documentElement, { attributes: true, attributeFilter: ['lang'] })
+  }
+  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start, { once: true })
+  else start()
+})()
