# sporta-web/public/sporta-checkout-a11y.css : A-08 A-10 A-12 A-13 A-20 A-28
diff --git a/sporta-web/public/sporta-checkout-a11y.css b/sporta-web/public/sporta-checkout-a11y.css
index a6bd9f4..82d1e25 100644
--- a/sporta-web/public/sporta-checkout-a11y.css
+++ b/sporta-web/public/sporta-checkout-a11y.css
@@ -523,3 +523,64 @@ A-08 A-10 A-12 A-13 A-20 A-28
 .storefront-root .purchase-flow > h1,
 .storefront-root .purchase-flow .purchase-heading h1 { font-size: clamp(1.5rem, 2.4vw, 2rem); }
 .storefront-root .purchase-flow > h1 { margin-block: 1rem .5rem !important; }
+
+/* [A-08] The product page's buy bar (.action-bar, 73 px, below 768 px) and the checkout pay bar (.purchase-paybar,
+ * 69-71 px, below 1024 px) are position:fixed at bottom:0, and the footer's only bottom padding is the safe-area inset
+ * (0 px on most screens), so at the very end of the page the bar sits on the last lines of the footer: the copyright and
+ * operator lines are hidden (Arabic 390 and 430: the whole operator line, 17 of 17 px; 320 and 360: 25 of 35 px).
+ * 3rem clears them with 15-23 px to spare on the live footer; the repo's compacted footer (sizes lane, 16 px shorter) still
+ * clears by 7 px, where 2.5rem left 1-2 px of the last line under the bar. */
+@media (max-width: 767.98px) {
+  body:has(.action-bar) .app-footer {
+    padding-bottom: calc(3rem + var(--sa-bottom, 0px));
+  }
+}
+@media (max-width: 1023.98px) {
+  body:has(.purchase-paybar) .app-footer {
+    padding-bottom: calc(3rem + var(--sa-bottom, 0px));
+  }
+}
+
+/* [A-10] /payment/result: the bordered, rounded result card has no outer margin and only an inner px-5, so under 576 px
+ * it is as wide as the screen and its border and corners touch the screen edges (x 0 to 320 against a 16 px header
+ * gutter). Keep it one gutter in from each edge; from 608 px the 36rem cap applies and it is centred as before. */
+main .purchase-result {
+  max-width: min(36rem, calc(100% - var(--shop-gutter-start, 1rem) - var(--shop-gutter-end, 1rem)));
+}
+
+/* [A-12] The sticky order summaries slide under the sticky header from 1024 px up: the header is 142.8-146.5 px tall; the
+ * cart summary sticks at top:8rem (132-136 px, 10 px of its top border and corners hidden) and the checkout summary at
+ * lg:top-28 (116-119 px, 27 px hidden, the "Order summary" heading about 8 px under the header). 9.5rem (about 152-160 px)
+ * is the value the checkout rule in this repo's own sporta-checkout-a11y.css already uses: the header and a 7-15 px gap. */
+@media (min-width: 1024px) {
+  .purchase-cart__summary,
+  .purchase-flow .purchase-checkout-layout > aside {
+    top: 9.5rem;
+  }
+}
+
+/* [A-13] The mobile-number field is a box inside a box: its wrapper keeps the shared input padding (px-3 py-2.5 win over
+ * p-0) and its own border, so the grey +965 chip and the inner input (second border, 12 px radius) float inside it. The
+ * group is 70-74 px tall against 48-50 px for every other field. The wrapper keeps its single border and focus ring. */
+.purchase-checkout-layout .purchase-field > .flex.items-stretch {
+  padding: 0 !important;
+}
+.purchase-checkout-layout .purchase-field > .flex.items-stretch > input {
+  border: 0 !important;
+  border-radius: 0 !important;
+  min-height: calc(3rem - 2px);
+}
+
+/* [A-20] The Governorate select is 2-2.6 px taller than the Area input beside it (native line box on top of its
+ * min-height): 50.4 against 48 px on phones, 52.6 against 50.5 at 1280. */
+.purchase-checkout-layout select {
+  height: 3rem;
+  min-height: 3rem;
+  box-sizing: border-box;
+}
+
+/* [A-28] The grand total (and its "calculating total" words) has letter-spacing -0.025em with no RTL twin. Arabic joins
+ * must not be tracked. Same fix as F2-17 in fonts-proposed.diff: apply once. */
+[dir="rtl"] .purchase-checkout-summary .purchase-total .text-accent {
+  letter-spacing: 0;
+}

