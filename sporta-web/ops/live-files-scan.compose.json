{
  "services": {
    "filesscan": {
      "image": "node:24-alpine",
      "restart": "no",
      "network_mode": "none",
      "read_only": true,
      "environment": {
        "SRC": "",
        "MAN": ""
      },
      "volumes": [
        "/docker/sporta:/sporta:ro"
      ],
      "tmpfs": [
        "/tmp:size=32m",
        "/out:size=64m,mode=0700"
      ],
      "entrypoint": [
        "/bin/sh",
        "-c"
      ],
      "command": [
        "printenv SRC | base64 -d | gunzip > /tmp/s.mjs && printenv MAN | base64 -d | gunzip > /tmp/m.json && node /tmp/s.mjs --root /sporta --manifest /tmp/m.json --details /out/details.ndjson"
      ]
    }
  }
}
