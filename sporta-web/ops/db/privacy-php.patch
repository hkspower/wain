+<?php
+// Retention and erasure of personal data, from the command line ONLY.
+//
+//   php cron-privacy.php retention                       preview: counts per rule, changes nothing
+//   php cron-privacy.php retention --apply               blank/delete what the rules say (batched)
+//   php cron-privacy.php erase --phone P --email E       preview for one person
+//   php cron-privacy.php erase --phone P --email E --apply
+//   php cron-privacy.php reapply [--apply]               after a restore from an older backup
+//
+// Needs config keys: 'privacy_salt' (a long random secret; required to --apply an erasure or a reapply, and for
+// identity_days > 0) and optionally 'privacy' => ['orders_days' => 90, ...]. Prints rule ids and row counts, never a
+// value. Over HTTP it answers 404 and does nothing.
+declare(strict_types=1);
+if (PHP_SAPI !== 'cli') { http_response_code(404); exit; }
+require __DIR__ . '/store.php';
+require __DIR__ . '/privacy.php';
+
+$args = $argv; array_shift($args);
+$cmd = $args[0] ?? '';
+$opts = [];
+for ($i = 1; $i < count($args); $i++) {
+    if ($args[$i] === '--apply') { $opts['apply'] = true; continue; }
+    if (in_array($args[$i], ['--phone', '--email'], true) && isset($args[$i + 1])) { $opts[ltrim($args[$i], '-')] = $args[++$i]; continue; }
+    fwrite(STDERR, "unknown argument\n"); exit(2);
+}
+if (!in_array($cmd, ['retention', 'erase', 'reapply'], true)) { fwrite(STDERR, "usage: cron-privacy.php retention|erase|reapply [--apply] [--phone P] [--email E]\n"); exit(2); }
+$apply = !empty($opts['apply']);
+$cfg = store_config();
+$vars = privacy_vars($cfg, ['phone' => (string)($opts['phone'] ?? ''), 'email' => (string)($opts['email'] ?? '')]);
+if ($cmd === 'erase' && $vars['p8'] === '' && $vars['em'] === '') { fwrite(STDERR, "erase needs --phone and/or --email\n"); exit(2); }
+if ($apply && in_array($cmd, ['erase', 'reapply'], true) && $vars['salt'] === '') { fwrite(STDERR, "privacy_salt is not configured\n"); exit(3); }
+if ($apply && $cmd === 'retention' && $vars['identity_days'] > 0 && $vars['salt'] === '') { fwrite(STDERR, "identity_days needs privacy_salt\n"); exit(3); }
+$db = store_db();
+$result = ['mode' => $apply ? 'apply' : 'preview', 'rules' => privacy_run($db, $cmd, $vars, $apply)];
+if ($cmd === 'erase') $result['not_changed'] = privacy_run($db, 'report', $vars, false);
+echo json_encode($result, JSON_UNESCAPED_SLASHES), "\n";
