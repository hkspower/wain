+
+function privacy_ledger_statements(): array {
+    return [
+        'L-PHONE' => ['insert ignore into privacy_erasures (id_kind, id_hash, scope) select \'phone\', sha2(concat(?, ?), 256), \'erase\' from dual where ? <> \'\' and ? <> \'\'', ['salt', 'p8', 'p8', 'salt']],
+        'L-EMAIL' => ['insert ignore into privacy_erasures (id_kind, id_hash, scope) select \'email\', sha2(concat(?, ?), 256), \'erase\' from dual where ? <> \'\' and ? <> \'\'', ['salt', 'em', 'em', 'salt']],
+    ];
+}
+
+function privacy_values(array $vars, array $names): array {
+    return array_map(static fn(string $n) => $vars[$n], $names);
+}
+
+/**
+ * Run one rule set. Returns [rule id => rows]. $apply=false only counts.
+ * Updates and deletes run in batches of $batch rows (a rule that cannot take LIMIT runs once), so a big table never
+ * holds a long lock; an erasure runs inside ONE transaction.
+ */
+function privacy_run(PDO $db, string $set, array $vars, bool $apply, int $batch = 500): array {
+    $rules = privacy_rules($set);
+    $out = [];
+    $tx = $apply && ($set === 'erase' || $set === 'reapply');
+    if ($tx) $db->beginTransaction();
+    try {
+        foreach ($rules as $id => $rule) {
+            [$sql, $names] = $apply && $rule['apply'] ? $rule['apply'] : $rule['preview'];
+            if (!$apply || !$rule['apply']) {
+                $q = $db->prepare($sql);
+                $q->execute(privacy_values($vars, $names));
+                $out[$id] = (int)$q->fetchColumn();
+                continue;
+            }
+            $total = 0;
+            $stmt = $db->prepare(str_replace('%LIMIT%', (string)max(1, $batch), $sql));
+            do {
+                $stmt->execute(privacy_values($vars, $names));
+                $n = $stmt->rowCount();
+                $total += $n;
+            } while ($rule['limit'] && $n >= $batch);
+            $out[$id] = $total;
+        }
+        if ($apply && $set === 'erase') {
+            if ($vars['salt'] === '') throw new RuntimeException('privacy_salt_required');
+            foreach (privacy_ledger_statements() as [$sql, $names]) $db->prepare($sql)->execute(privacy_values($vars, $names));
+        }
+        if ($apply) {
+            $db->prepare('insert into privacy_runs (kind, dry_run, policy_json, affected_json) values (?, 0, ?, ?)')
+               ->execute([$set === 'retention' ? 'retention' : $set, json_encode(array_intersect_key($vars, array_flip(['orders_days', 'identity_days', 'support_days', 'returns_days', 'outbox_days', 'resets_days', 'activity_days']))), json_encode($out)]);
+        }
+        if ($tx) $db->commit();
+    } catch (Throwable $e) {
+        if ($tx && $db->inTransaction()) $db->rollBack();
+        throw $e;
+    }
+    return $out;
+}
