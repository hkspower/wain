{
  "services": {
    "dbaudit": {
      "image": "node:24-alpine",
      "restart": "no",
      "environment": {
        "SRC": ""
      },
      "volumes": [
        "/docker/sporta/private/api-config.php:/run/sporta-api-config.php:ro",
        "/docker/sporta/private/db_name:/run/secrets/sporta_db_name:ro",
        "/docker/sporta/private/db_user:/run/secrets/sporta_db_user:ro",
        "/docker/sporta/private/db_pass:/run/secrets/sporta_db_pass:ro"
      ],
      "networks": [
        "sporta-db_default"
      ],
      "entrypoint": [
        "/bin/sh",
        "-c"
      ],
      "command": [
        "printenv SRC | base64 -d | gunzip > /tmp/a.mjs && node /tmp/a.mjs --config /run/sporta-api-config.php --order-retention-days 1825"
      ]
    }
  },
  "networks": {
    "sporta-db_default": {
      "external": true
    }
  }
}
