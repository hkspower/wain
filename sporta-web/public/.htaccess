# Sporta — Hostinger (Apache) production config: SPA routing + compression + caching.

# ---- Canonicalise host + scheme in a SINGLE 301 (never chain redirects) ----
# Everything on the site declares https://www.sporta.com.kw as canonical, so any
# other spelling of the URL jumps straight there in one hop. Rule 1 fixes host
# AND scheme together, so http://sporta.com.kw/x is ONE redirect, not two.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Wrong host (bare domain, old alias, IP) -> canonical host over HTTPS.
  # (:port tolerated — Host carries a port on non-default ports / odd proxies.)
  RewriteCond %{HTTP_HOST} !^www\.sporta\.com\.kw(:[0-9]+)?$ [NC]
  RewriteRule ^ https://www.sporta.com.kw%{REQUEST_URI} [R=301,L]

  # 2) Right host, plain HTTP -> HTTPS. Hostinger terminates SSL at a proxy, so
  #    Apache often sees plain HTTP even for real HTTPS hits. Redirect ONLY when
  #    every signal says insecure — if one is missing we serve the page instead
  #    of risking an infinite http->https->http loop.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP:X-Forwarded-SSL} !=on
  RewriteCond %{SERVER_PORT} !=443
  RewriteRule ^ https://www.sporta.com.kw%{REQUEST_URI} [R=301,L]
</IfModule>

# ---- One URL per page (kill duplicates without adding redirect hops) ----
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # /index.html -> / . Guarded by THE_REQUEST, which keeps the ORIGINAL request
  # line even after an internal rewrite, so the SPA rewrite below (which targets
  # /index.html internally) can never re-enter this rule and loop.
  # Target is the ABSOLUTE canonical URL, not "/": behind Hostinger's SSL-
  # terminating proxy Apache sees plain HTTP, so a path-only target would be
  # expanded to http:// and bounce through the HTTPS rule = 2 hops.
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ https://www.sporta.com.kw/ [R=301,L]

  # /shop/ -> /shop . Canonicals and internal links never use a trailing slash;
  # this stops the slashed spelling becoming a second indexable URL.
  # !-d keeps real directories (/assets/) working.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+?)/+$ https://www.sporta.com.kw/$1 [R=301,L]
</IfModule>

# ---- SPA routing: only KNOWN routes become 200 ----
# Internal rewrites (no R flag), so deep links cost zero redirect hops and the
# browser keeps /shop in the address bar.
#
# A catch-all ". -> /index.html" would answer 200 for EVERY made-up URL, which
# Google treats as a soft 404: crawl budget burnt on junk and the URL is
# eligible for indexing. So each real route is listed, and anything unmatched
# falls through to the ErrorDocument below, which serves the same SPA shell
# with a genuine 404 status.
#
# ►► ADDING A ROUTE TO App.jsx? ADD IT HERE TOO, or it will 404. ◄◄
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]

  # Real files and directories always win (assets, sitemap.xml, robots.txt…).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^(shop|cart|checkout|about|contact|wishlist|track|returns)/?$ /index.html [L]
  RewriteRule ^product/[^/]+/?$        /index.html [L]
  RewriteRule ^payment/result/?$       /index.html [L]
  RewriteRule ^admin(/.*)?$            /index.html [L]
</IfModule>

# Unknown URL -> SPA shell rendered with a real 404 status (not a soft 404).
# React Router still sees the original path and renders the NotFound page.
ErrorDocument 404 /index.html

# Unknown product slugs stay 200 by design: the server cannot know the
# catalogue, and ProductDetail already sends robots "noindex, follow" for them.

# ---- HSTS: tell browsers to always use HTTPS for this domain ----
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ---- Compression (Brotli if available, else gzip) ----
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css application/json application/javascript text/javascript image/svg+xml application/xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/json application/javascript text/javascript image/svg+xml application/xml
</IfModule>

# ---- Caching ----
<IfModule mod_expires.c>
  ExpiresActive On

  # ONLY content-hashed Vite output (index-CuCZhORW.js, About-sNx2ecy0.css)
  # may be immutable: the filename changes whenever the bytes change.
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Fixed-name files (favicon.png, logo.png, og-image.png, fonts) keep their
  # name across deploys, so they must NOT be immutable — a replaced logo would
  # be stuck in browser caches for a year. 30 days + revalidation instead.
  <FilesMatch "\.(woff2?|ttf|eot|svg|png|jpe?g|gif|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # config.js carries the site's settings and is edited in place on the
  # server. If it were cached, changing a Supabase URL would appear to do
  # nothing for as long as the cache lasted.
  <Files "config.js">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>

  # HTML must always revalidate so users get new deploys immediately.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
    ExpiresByType text/html "access plus 0 seconds"
  </FilesMatch>
</IfModule>

# ---- Security headers ----
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Cross-Origin-Opener-Policy "same-origin"
  Header set X-Permitted-Cross-Domain-Policies "none"

  # Don't advertise the PHP version to attackers.
  Header always unset X-Powered-By

  # Turn off browser features the storefront never uses.
  Header set Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), xr-spatial-tracking=()"

  # Content-Security-Policy.
  # 'unsafe-inline' is required for script-src because index.html carries
  # inline JSON-LD (and the static build of this site carries inline page
  # scripts). Even so the policy still blocks third-party script hosts,
  # <object>/<embed>, <base> hijacking and cross-origin framing.
  # connect-src covers Supabase (admin panel); fonts.* cover Google Fonts;
  # form-action lists the KNET gateway in case pay.php ever posts a form.
  Header set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; form-action 'self' https://kpay.com.kw https://kpaytest.com.kw; upgrade-insecure-requests"
</IfModule>

# ---- Never serve VCS metadata, env files, manifests or backups ----
# Defence in depth: these should not be in public_html at all, but an SFTP
# upload of the wrong folder must not leak credentials or source.
# .well-known is exempt so SSL/ACME renewal keeps working.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule "(?i)(^|/)\.(?!well-known)" - [F,L]
</IfModule>
<FilesMatch "(?i)^(composer\.(json|lock)|package(-lock)?\.json|yarn\.lock|pnpm-lock\.yaml|vite\.config\.[cm]?[jt]s|(ts|js)config\.json|Dockerfile|docker-compose\.ya?ml|.*\.(bak|old|orig|save|swp|sql|log|sh|env))$">
  Require all denied
</FilesMatch>

# Keep the server version out of generated error pages.
ServerSignature Off

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>
