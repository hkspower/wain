# Sporta — Hostinger (Apache) production config: SPA routing + compression + caching.

# ---- Deny dotfiles FIRST, before anything else can short-circuit it ----
# Order is the whole point. This rule used to sit at the bottom of the file,
# where it was dead: the SPA block passes any request whose target exists
# through with [L], so it only ever saw dotfiles that were not there. Under
# Apache, .DS_Store, .deploy-manifest.json and .git/config all returned 200
# with their full contents — and a readable .git/config means the entire
# repository can be reconstructed. Nothing may precede this.
# .well-known stays reachable so SSL/ACME renewal keeps working.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule "(?i)(^|/)\.(?!well-known)" - [F,L]
</IfModule>

# ---- index.html is the fallback homepage, never index.php ----
# The live server still has an index.php from the previous PHP site sitting
# beside index.html. Hostinger's default DirectoryIndex lists index.php first,
# so "/" would serve the OLD site while every deep route served the new one —
# and nothing about that looks broken enough to notice. Stating the order here
# removes the dependence on the host's default entirely.
DirectoryIndex index.html

# Directory listings must never be generated. public_html has folders from the
# old site (images/, fonts/, private/) with no index file of their own.
Options -Indexes

# The previous PHP deployment may leave a physical /backends directory beside
# the SPA.  Apache's mod_dir can issue DirectorySlash before that directory
# reaches the SPA rewrite, which creates a /backends <-> /backends/ loop when
# an old redirect is still present.  No directory in the storefront needs a
# slash-only index, so disable that automatic redirect; the explicit route
# rules below own /backends and /backends/ instead.
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

# ---- Canonicalise host + scheme in a SINGLE 301 (never chain redirects) ----
# Everything on the site declares https://www.sporta.com.kw as canonical, so any
# other spelling of the URL jumps straight there in one hop. Rule 1 fixes host
# AND scheme together, so http://sporta.com.kw/x is ONE redirect, not two.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Aliases sit ABOVE the host rule so sporta.com.kw/x also lands in ONE hop.
  # ---- Old-site URLs Google still requests -> the page that replaced them ----
  # Seen in the live access log 2026-10-31 (/women, /privacy-policy?lang=en, an
  # /image/cache/catalog/... photo), each answering 404 and wasting the link
  # equity the old shop had built. ONE 301 straight to the canonical https://www
  # address (never a path-only target: behind the TLS proxy that would expand to
  # http:// and add a hop). No "?" in the targets, so ?lang=en rides along;
  # QSA merges it with the category query.
  RewriteRule ^(women|men|accessories)/?$ https://www.sporta.com.kw/shop?category=$1 [NC,R=301,L,QSA]
  RewriteRule ^privacy-policy/?$ https://www.sporta.com.kw/privacy [NC,R=301,L]
  RewriteRule ^(terms-and-conditions|terms-conditions)/?$ https://www.sporta.com.kw/terms [NC,R=301,L]
  RewriteRule ^(return-policy|returns-policy)/?$ https://www.sporta.com.kw/returns [NC,R=301,L]
  RewriteRule ^about-us/?$ https://www.sporta.com.kw/about [NC,R=301,L]
  RewriteRule ^contact-us/?$ https://www.sporta.com.kw/contact [NC,R=301,L]
  # Policy addresses people type or old links use (added 2026-10-31).
  # /shipping keeps ?lang=en and lands on the delivery section of /terms.
  RewriteCond %{QUERY_STRING} ^(.+)$
  RewriteRule ^(shipping|delivery|shipping-policy|delivery-policy)/?$ https://www.sporta.com.kw/terms?%1#delivery [NC,R=301,L,NE,QSD]
  RewriteRule ^(shipping|delivery|shipping-policy|delivery-policy)/?$ https://www.sporta.com.kw/terms#delivery [NC,R=301,L,NE]
  RewriteRule ^(refund|refunds|refund-policy|return)/?$ https://www.sporta.com.kw/returns [NC,R=301,L]
  RewriteRule ^policy/?$ https://www.sporta.com.kw/privacy [NC,R=301,L]
  RewriteRule ^policies/?$ https://www.sporta.com.kw/terms [NC,R=301,L]
  # The old catalogue's image cache is gone for good. 410 Gone makes Google drop
  # those URLs sooner than a 404 does; today's photos live under /images/.
  RewriteRule ^image/(cache|catalog)/ - [NC,G,L]

  # 0) The old file names of the home page and the panel go straight to their
  #    canonical URL. Rule 1 below would send them to https://www/index.html
  #    first and only then to "/": two hops for one page. THE_REQUEST keeps the
  #    original request line, so the internal SPA rewrite to /index.html (further
  #    down) can never re-enter these rules and loop.
  RewriteCond %{THE_REQUEST} \s/+index\.(html|php)[\s?] [NC]
  RewriteCond %{QUERY_STRING} ^$
  RewriteRule ^index\.(html|php)$ https://www.sporta.com.kw/ [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+index\.(html|php)[\s?] [NC]
  RewriteRule ^index\.(html|php)$ https://www.sporta.com.kw/?%{QUERY_STRING} [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+panel\.php[\s?] [NC]
  RewriteRule ^panel\.php$ https://www.sporta.com.kw/backends?via=panel-20261026 [R=302,L,NE]

  # 1) Wrong host (bare domain, old alias, IP) -> canonical host over HTTPS.
  # (:port tolerated — Host carries a port on non-default ports / odd proxies.)
  RewriteCond %{HTTP_HOST} !^www\.sporta\.com\.kw(:[0-9]+)?$ [NC]
  RewriteRule ^ https://www.sporta.com.kw%{REQUEST_URI} [R=301,L]

  # 2) Right host, plain HTTP -> HTTPS. Hostinger terminates SSL at a proxy, so
  #    Apache often sees plain HTTP even for real HTTPS hits. Redirect ONLY when
  #    every signal says insecure — if one is missing we serve the page instead
  #    of risking an infinite http->https->http loop.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP:X-Forwarded-SSL} !=on
  RewriteCond %{SERVER_PORT} !=443
  RewriteRule ^ https://www.sporta.com.kw%{REQUEST_URI} [R=301,L]
</IfModule>

# ---- One URL per page (kill duplicates without adding redirect hops) ----
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # /index.html -> / . Guarded by THE_REQUEST, which keeps the ORIGINAL request
  # line even after an internal rewrite, so the SPA rewrite below (which targets
  # /index.html internally) can never re-enter this rule and loop.
  # Target is the ABSOLUTE canonical URL, not "/": behind Hostinger's SSL-
  # terminating proxy Apache sees plain HTTP, so a path-only target would be
  # expanded to http:// and bounce through the HTTPS rule = 2 hops.
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ https://www.sporta.com.kw/ [R=301,L]

  # /index.php -> / . The previous PHP site's front controller is STILL in the
  # live public_html — publish reports it as a leftover every run — and while
  # DirectoryIndex stops it answering "/", it answered /index.php with a 200 and
  # the whole old site. Found by scripts/storage-audit.mjs, which asserts it now.
  #
  # Two things wrong with that, and this rule fixes both. It was a second
  # indexable spelling of the homepage, which is the one thing CLAUDE.md says
  # must never exist; and it EXECUTED old PHP, with whatever that code does. A
  # rewrite in .htaccess runs at fixup, before the PHP handler, so the file is
  # never run — a 301 here is not cosmetic.
  #
  # Anchored on the full REQUEST_URI, not the filename, so it only ever catches
  # the one at the web root. A <Files "index.php"> would inherit into every
  # subfolder and 301 any nested index.php a dropin might add.
  RewriteCond %{REQUEST_URI} ^/index\.php$
  RewriteRule ^ https://www.sporta.com.kw/ [R=301,L]
  

  # Keep the owner's saved panel link working without executing a legacy PHP file.
  # The query also bypasses an old cached /backends <-> /backends/ redirect
  # pair in browsers that visited the previous deployment.
  RewriteRule ^panel\.php$ https://www.sporta.com.kw/backends?via=panel-20261026 [R=302,L,NE]

  # Do not canonicalise trailing slashes globally. SPA product links may be
  # opened with either spelling, and a proxy/browser can replay the redirect
  # while the client router restores its canonical product URL. Both spellings
  # are accepted by the explicit SPA rules below, avoiding redirect loops.
</IfModule>

# ---- SPA routing: only KNOWN routes become 200 ----
# Internal rewrites (no R flag), so deep links cost zero redirect hops and the
# browser keeps /shop in the address bar.
#
# A catch-all ". -> /index.html" would answer 200 for EVERY made-up URL, which
# Google treats as a soft 404: crawl budget burnt on junk and the URL is
# eligible for indexing. So each real route is listed, and anything unmatched
# falls through to the ErrorDocument below, which serves the same SPA shell
# with a genuine 404 status.
#
# ►► ADDING A ROUTE TO App.jsx? ADD IT HERE TOO, or it will 404. ◄◄
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]

  # Resolve the XML endpoints before the real-file guard: generated static XML
  # files are kept beside these routes as safe fallbacks when the PHP drop-in
  # or database is unavailable. The live product map reads active DB products.
  RewriteCond %{DOCUMENT_ROOT}/api/sitemap-index.php -f
  RewriteRule ^sitemap\.xml$ /api/sitemap-index.php [END]
  RewriteCond %{DOCUMENT_ROOT}/api/sitemap-products.php -f
  RewriteRule ^sitemap-products\.xml$ /api/sitemap-products.php [END]

  # Initial HTML metadata must describe the requested route even for crawlers
  # that do not run React. A missing PHP drop-in still leaves the static shell.
  RewriteCond %{DOCUMENT_ROOT}/api/seo-page.php -f
  RewriteRule ^$ /api/seo-page.php [END]

  # The old deployment may leave a physical /backends directory beside the
  # new SPA. Route this admin URL before the real-directory guard; otherwise
  # Apache's DirectorySlash handling wins and /backends and /backends/ can
  # redirect forever without ever reaching React Router.
  # A trailing slash on the admin address is not a page: 404 it, as any unknown path is.
  RewriteRule ^backends/+$ - [R=404,L]
  RewriteCond %{DOCUMENT_ROOT}/api/seo-page.php -f
  RewriteRule ^backends(/.*)?$ /api/seo-page.php [END]
  RewriteRule ^backends/?$ /index.html [END]
  RewriteRule ^backends/.*$ /index.html [END]

  # Real files and directories always win (assets, sitemap.xml, robots.txt…).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteCond %{DOCUMENT_ROOT}/api/seo-page.php -f
  RewriteRule ^(shop|cart|checkout|account|about|contact|support|wishlist|track|returns|exchange|terms|privacy|review)/?$ /api/seo-page.php [END]
  RewriteCond %{DOCUMENT_ROOT}/api/seo-page.php -f
  RewriteRule ^product/[^/]+/?$ /api/seo-page.php [END]
  RewriteCond %{DOCUMENT_ROOT}/api/seo-page.php -f
  RewriteRule ^payment/result/?$ /api/seo-page.php [END]
  RewriteCond %{DOCUMENT_ROOT}/api/seo-page.php -f
  RewriteRule ^invoice/[A-Za-z0-9]{1,30}/?$ /api/seo-page.php [END]

  RewriteRule ^(shop|cart|checkout|account|about|contact|support|wishlist|track|returns|exchange|terms|privacy|review)/?$ /index.html [L]
  RewriteRule ^product/[^/]+/?$        /index.html [L]
  RewriteRule ^payment/result/?$       /index.html [L]
  # /invoice/<order number>. A parameterised route, so it needs its own rule —
  # the alternation list above only matches fixed paths.
  RewriteRule ^invoice/[A-Za-z0-9]{1,30}/?$ /index.html [L]
</IfModule>

# Unknown URL -> SPA shell rendered with a real 404 status (not a soft 404).
# React Router still sees the original path and renders the NotFound page.
ErrorDocument 404 /index.html

# A live database now distinguishes active products from missing/inactive
# slugs, returning a real 404 and noindex. On database outage the static shell
# still loads, with X-Robots-Tag noindex until the catalogue can be checked.

# ---- HSTS: tell browsers to always use HTTPS for this domain ----
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ---- The 404 shell is compressed like every other page (2026-11-03, page weight) ----
# `ErrorDocument 404 /index.html` below hands every unknown URL the whole SPA shell
# (27 kB of HTML). That body is produced by an internal redirect to a NEW request
# whose content type the type-based filters further down never see at the moment
# they decide, so it went out UNcompressed: every probe of /wp-login.php, every
# stale link to an old-site URL and every request for a file that is not there
# (a product photograph copy that does not exist, say) cost the full 27,272 bytes.
# Measured under Apache 2.4.58 against this very file: 27,272 B without this block,
# 10,144 B (gzip) with it (scripts/htaccess-rules-test.mjs, section 6, and
# npm run test:sizes-weight). The filter is named for the 404 status itself, which
# is known by then. Both filters, in the order the type-based lines use: a client
# that offers br gets Brotli, one that only offers gzip gets gzip, one that offers
# neither gets the plain page.
<If "%{REQUEST_STATUS} == 404">
  <IfModule mod_deflate.c>
    SetOutputFilter DEFLATE
  </IfModule>
  <IfModule mod_brotli.c>
    <IfModule mod_deflate.c>
      SetOutputFilter BROTLI_COMPRESS;DEFLATE
    </IfModule>
  </IfModule>
</If>

# ---- Compression (Brotli if available, else gzip) ----
# application/manifest+json is listed explicitly: .webmanifest is not covered by
# application/json, so the manifest was the one text file served uncompressed.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css application/json application/javascript text/javascript image/svg+xml application/xml application/manifest+json
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/json application/javascript text/javascript image/svg+xml application/xml application/manifest+json
</IfModule>

# ---- Caching ----
#
# Cache-Control comes from mod_headers, so it is gated on mod_headers. It used
# to sit inside <IfModule mod_expires.c>, which measured out under Apache as:
# no mod_expires, NO Cache-Control at all. Not the immutable year on hashed
# assets, not the thirty days on images — and not config.js's no-cache either,
# so editing a backend URL in File Manager would have looked like it did
# nothing. mod_expires now carries only the directive that is genuinely its own.
#
# ETags: Apache's default includes the inode, which changes when files are
# restored from a backup or the account is moved between servers. Every image
# and every HTML revalidation would then miss and re-download for no reason.
# MTime and Size describe the file, not where it happens to sit.
FileETag MTime Size

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Revalidation of a COMPRESSED text file answers 304 (2026-11-03, page weight).
  #
  # mod_deflate / mod_brotli give the compressed copy an ETag ending in "-gzip" /
  # "-br" (the plain file's is "1c6-62f..."), and a browser sends back exactly what
  # it was given. Apache compares that request header with the PLAIN ETag, so
  # "1c6-62f...-gzip" never matched: every conditional request for a file below
  # that carries no-cache answered a full 200 with the whole body again instead of
  # a 304 with none. Measured, real Apache 2.4.58 with this file: robots.txt,
  # sw.js, config.js, boot.js, site.webmanifest and the sitemaps all returned 200
  # to their own compressed ETag. That is every fixed-name add-on the storefront
  # links (14 stylesheets and 6 scripts, plus boot.js, config.js and birthday.js:
  # 23 files) re-sent in full on EVERY page load of a returning visitor: 51.5 kB
  # gzip for the copies live on 2026-11-02, about 145 kB gzip (137 kB Brotli) for
  # the copies in this repo on 2026-11-04 (it grows as the add-ons do). With this line they are 23 empty 304s (scripts/htaccess-rules-test.mjs
  # section 5 asserts all 23, with gzip's validator and Brotli's).
  # DeflateAlterETag / BrotliAlterETag would remove the suffix at the source, but
  # they are server-config only (a 500 from .htaccess). This strips the suffix from
  # the REQUEST before the conditional is evaluated (mod_headers runs at fixup, the
  # conditional later, in the handler). `edit`, not `edit*` (see the Set-Cookie note
  # below), so it rewrites the first validator, which is all a browser sends; a
  # request without a suffix is left exactly as it was.
  RequestHeader edit If-None-Match "-(?:gzip|br)(\")" "$1"

  # ONLY content-hashed Vite output (index-CuCZhORW.js, About-sNx2ecy0.css)
  # may be immutable: the filename changes whenever the bytes change. No
  # revalidation, ever — which is why nothing else may claim it.
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Fixed-name files (favicon.png, logo.png, og-image.png, fonts) keep their
  # name across deploys, so they must NOT be immutable — a replaced logo would
  # be stuck in browser caches for a year. 30 days, and for the week after that
  # the old copy is drawn immediately while the new one is fetched behind it, so
  # the visit after a month is not slower than the ones before it.
  <FilesMatch "\.(woff2?|ttf|otf|eot|svg|png|jpe?g|gif|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=604800"
  </FilesMatch>

  # ...except the pictures the owner actually REPLACES.
  #
  # /hero and /cats are shipped artwork with fixed filenames, and swapping one
  # is a normal thing to do — a new hero, a new category tile. Thirty days of
  # hard freshness meant a returning visitor could not see the change for a
  # month, and the service worker held the same file cache-first on top of
  # that, so on neither path did the new picture arrive. A day fresh, then a
  # month of drawing the old copy instantly while the new one is fetched
  # behind it: same speed on every visit, a day's lag instead of a month's.
  #
  # SetEnvIf picks the FOLDER, because that is what the distinction is —
  # logo.png and the favicons keep the thirty days above, and .htaccess cannot
  # open a <Directory> block.
  #
  # The override then has to sit inside a <FilesMatch> of its own, and that is
  # not cosmetic. Apache applies directives from a <FilesMatch> section AFTER
  # the ones in the enclosing scope, whatever the order in the file — so the
  # same rule written at this level was silently overwritten by the block
  # above it. Measured against a real Apache: 2592000, not 86400. Same kind of
  # section, later in the file, is what actually wins.
  SetEnvIf Request_URI "^/(hero|cats)/" SPORTA_REPLACEABLE_IMAGE
  <FilesMatch "\.(png|jpe?g|gif|webp|avif)$">
    Header set Cache-Control "public, max-age=86400, stale-while-revalidate=2592000" env=SPORTA_REPLACEABLE_IMAGE
  </FilesMatch>

  # robots.txt, llms.txt, the sitemaps and site.webmanifest had NO Cache-Control
  # at all, so every cache in the path guessed. They change only on a deploy and
  # crawlers fetch them repeatedly: an hour fresh, a day of serving the old copy
  # while refreshing.
  <FilesMatch "\.(xml|txt|webmanifest|json)$">
    Header set Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
  </FilesMatch>

  # sw.js must always be revalidated, and it matched NONE of the rules above:
  # not the hashed-asset pattern (its name is fixed, on purpose — the browser
  # looks for it at exactly this path), and not the .xml/.txt/.json group. So it
  # had no Cache-Control at all and every cache in the path guessed. A stale
  # service worker is the worst kind of stale: it decides what the whole site is
  # allowed to cache, so one pinned copy can outlive several deploys.
  <Files "sw.js">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>

  # config.js carries the site's settings and is edited in place on the
  # server. If it were cached, changing a backend URL would appear to do
  # nothing for as long as the cache lasted. Must stay AFTER the rules above so
  # it wins; it is not hashed, so none of them match it, but ordering is the
  # thing that keeps that true if a rule is ever widened.
  <Files "config.js">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>

# boot.js and backends-offline.css have fixed names (not hashed), so like sw.js
# and config.js they must revalidate — they had NO Cache-Control and every cache
# guessed (found by the 2026-10-31 CSS scan).
<FilesMatch "^(boot\.js|birthday\.js|sporta-footer-call\.js|sporta-admin-brands\.js|sporta-features\.js|sporta-brand-theme\.css|sporta-home-trim\.css|sporta-cart-drawer\.css|sporta-grid\.css|sporta-bag-touch\.css|sporta-cat-tiles\.css|sporta-gov-autopick\.js|sporta-admin-knet\.css|sporta-returns-touch\.css|sporta-clock\.css|sporta-clock\.js|sporta-ui-colours\.css|sporta-checkout-a11y\.(css|js)|sporta-shadows\.css|sporta-images\.css|sporta-product-fix\.css|backends-offline\.css)$">
  Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>

  # HTML always revalidates, so a deploy is picked up on the next visit.
  #
  # must-revalidate is deliberately NOT set here, and that is the whole change:
  # it forbids a cache from ever serving a stale copy, which cancels
  # stale-while-revalidate. Without it the shell paints from cache immediately
  # and the revalidation happens behind the paint — one fewer round trip before
  # anything appears, on a mobile connection in Kuwait.
  #
  # Sixty seconds of staleness is safe here for a specific reason: publish never
  # deletes, so the hashed assets a slightly-old shell asks for are still on the
  # server. A shell that outlived its assets would be a white screen; this one
  # cannot. Caches that do not implement stale-while-revalidate (Safari) simply
  # behave as they did before.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, stale-while-revalidate=60"
  </FilesMatch>
</IfModule>

# ---- Security headers ----
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Cross-Origin-Opener-Policy "same-origin"
  Header set X-Permitted-Cross-Domain-Policies "none"

  # Don't advertise the PHP version to attackers.
  Header always unset X-Powered-By

  # ---- Cookies ----
  # The storefront sets NO cookies. Nothing in src/ touches document.cookie; the
  # cart, wishlist, theme and language live in localStorage, and the admin's
  # admin session does too. So there is no consent banner because there is
  # nothing to consent to, and this rule currently rewrites nothing.
  #
  # It is here for the cookie that is not ours. PHP emits PHPSESSID the moment
  # anything calls session_start(); Hostinger can inject its own; a future
  # feature will add one and forget the flags. Any of those arriving without
  # Secure gets Secure and SameSite=Lax added on the way out — so a cookie
  # cannot leak over a downgraded connection or ride along on a cross-site POST,
  # whether or not whoever set it remembered.
  #
  # The negative lookahead is what stops a second "; Secure" being appended to a
  # cookie that already had it.
  #
  # `edit`, NOT `edit*`, and not `always`. Both were tried against Apache 2.4.58:
  #   * `Header edit*` SEGFAULTED the worker on every request that carried a
  #     Set-Cookie — with or without the lookahead. It is documented as "every
  #     instance" and is not safe to use here.
  #   * `always` writes to err_headers_out, and PHP's setcookie() writes to
  #     headers_out, so an `always edit` would silently never see PHPSESSID —
  #     the one cookie this rule exists for.
  # Plain `edit` was verified to rewrite BOTH of two Set-Cookie headers on one
  # response, so the `*` bought nothing even before it crashed.
  #
  # HttpOnly is deliberately NOT forced here: it is right for a session cookie
  # and wrong for one a script is meant to read, and silently breaking a future
  # feature is worse than this rule not covering it. The payment endpoints, where
  # no script reads anything, do force it — see dropin/php-*/.htaccess.
  # LiteSpeed does not implement Header edit and otherwise emits a literal
  # "edit" response header. PHP sets Strict/HttpOnly on the admin session;
  # retain the Apache fallback only where that operation is supported.
  <IfModule !LiteSpeed>
    Header edit Set-Cookie "(?i)^((?!.*;\s*Secure).*)$" "$1; Secure"
    Header edit Set-Cookie "(?i)^((?!.*;\s*SameSite=).*)$" "$1; SameSite=Lax"
  </IfModule>

  # Turn off browser features the storefront never uses.
  Header set Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(self), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), xr-spatial-tracking=()"

  # Content-Security-Policy.
  # No 'unsafe-inline' in script-src. The live site keeps its boot code in
  # /boot.js and ships plain script-src 'self'; this repo's index.html still
  # inlines two boot scripts, so the build writes their sha256 hashes into the
  # placeholder below (scripts/csp-hashes.mjs, run as postbuild) and the
  # policy allows those exact bytes and nothing else. JSON-LD is inert
  # structured data, and page metadata is written with textContent, not
  # executable code. This turns reflected HTML into text rather than a script
  # execution path.
  # connect-src is same-origin only now that /api is the whole backend;
  # use.typekit.net serves the licensed Adobe font CSS and font files;
  # p.typekit.net is the empty CSS import Adobe includes in each published kit;
  # form-action lists the KNET gateway in case pay.php ever posts a form.
  Header set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data:; font-src 'self' https://use.typekit.net; style-src 'self' 'unsafe-inline' https://use.typekit.net https://p.typekit.net; script-src 'self' __SCRIPT_HASHES__; connect-src 'self'; form-action 'self' https://kpay.com.kw https://kpaytest.com.kw; upgrade-insecure-requests"
  Header set Cross-Origin-Resource-Policy "same-origin"
</IfModule>

<IfModule LiteSpeed>
  ForceSecureCookie secure
</IfModule>

# ---- Dotfiles, everywhere, by NAME ----
# The rewrite rule at the top of this file does not reach subdirectories. Proved
# under Apache 2.4: with a /sub/.htaccess that merely says "RewriteEngine On",
# /sub/.token.json was served 200 WITH ITS CONTENTS while /.rootsecret.json in
# the same tree was 403. mod_rewrite directives are not inherited into a
# directory that enables its own rewrite engine, so /knet and /pay are safe only
# because each carries its own copy of the rule — and any folder added later
# would not be.
#
# A <FilesMatch> is inherited. Same harness, same subdirectory: /sub/x.log,
# /sub/secret.env, /sub/package.json and /sub/notes.md were all 403 from this
# file alone. So the dotfile deny is restated here by name, where it covers the
# whole tree without depending on rewrite semantics or on remembering to repeat
# it in every new folder.
#
# .well-known keeps working: it is a DIRECTORY, and the request that matters is
# /.well-known/acme-challenge/<token>, whose filename does not begin with a dot.
# Verified 200 with this rule in place — SSL renewal is untouched.
# __MACOSX — the folder Finder puts inside a zip, one shadow file per real
# file. It does NOT begin with a dot, so the rule below does not see it, and
# it is browsable: a directory index of everything the site is made of. It
# turns up whenever a folder is re-zipped on a Mac and re-uploaded.
RedirectMatch 404 (?i)(^|/)__MACOSX(/|$)

<FilesMatch "^\.(?!well-known$)">
  Require all denied
</FilesMatch>

# ---- Never serve VCS metadata, env files, manifests or backups ----
# The rewrite half of this rule lives at the TOP of the file, not here. Left in
# this position it did nothing at all: the SPA block above passes any request
# whose target exists straight through with [L], so a dotfile that is really on
# disk — the only kind that can leak — never reached the deny. Verified under
# Apache: .DS_Store, .deploy-manifest.json and .git/config were all served 200.
# What remains here is name-based and needs no rewrite ordering.
# The named files are not hypothetical — every one of them was photographed in
# the live public_html. deploy.config.json and deployhostinger.mjs describe how
# to reach the server; knet.log is the payment log; config-dist.php and
# knet-config.php are payment-credential files from the previous site. A .php
# file is normally safe because PHP executes it, but that protection vanishes
# the moment PHP is misconfigured or the module is disabled during an upgrade,
# which is exactly when the credentials would be served as plain text.
<FilesMatch "(?i)^(composer\.(json|lock)|package(-lock)?\.json|yarn\.lock|pnpm-lock\.yaml|vite\.config\.[cm]?[jt]s|(ts|js)config\.json|Dockerfile|docker-compose\.ya?ml|deploy\.config\.json|config-dist\.php|knet-config\.php|sporta-deploy\.php|sporta-deploy-config\.php|.*\.(bak|old|orig|save|swp|sql|log|json|jsonl|sh|env|zip|tar|gz|mjs|ts|md))$">
  Require all denied
</FilesMatch>

# json is in that list, and it is the one to notice: the site ships no .json file
# at all (site.webmanifest is .webmanifest, and the audit asserts the count is
# zero), so denying the class costs nothing and closes it for anything that lands
# there later — a stray .deploy-manifest.json, a copied deploy.config.json, or a
# cached bearer token. If a real .json ever needs serving, exempt that one
# filename with a <Files> block rather than reopening the class.
#
# The list also ends in zip|tar|gz|mjs|ts|md, and none of those is an
# oversight — the site ships no file of any of those types either, so denying the
# whole class is free, and each one is on the live server right now:
#   sporta-dist.zip        the entire built site, downloadable by anyone
#   smoke-cbk.mjs          payment smoke test
#   verify-deploy-assets.mjs
#   sporta-mac-check.sh    (already covered by sh)
#   vite.config.ts         build configuration
#   README-knet.md         describes the payment integration in detail
#
# sporta-deploy.php is named individually and is the reason this block matters
# more than the rest of the file: it is a deploy endpoint sitting in the web
# root, answering to anyone who requests it. Denying it here is a stopgap.
# DELETE IT — a deploy endpoint has no business being reachable from the
# internet at all, and no .htaccess rule is a substitute for its absence.

# Keep the server version out of generated error pages.
ServerSignature Off

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType font/ttf .ttf
  AddType font/otf .otf
</IfModule>

# sporta-session
<IfModule mod_php.c>
php_value session.gc_maxlifetime 7200
php_flag session.cookie_httponly on
php_value session.cookie_samesite Lax
</IfModule>
