# Sporta — Hostinger (Apache) production config: SPA routing + compression + caching.

# ---- Canonicalise host + scheme in a SINGLE 301 (never chain redirects) ----
# Everything on the site declares https://www.sporta.com.kw as canonical, so any
# other spelling of the URL jumps straight there in one hop. Rule 1 fixes host
# AND scheme together, so http://sporta.com.kw/x is ONE redirect, not two.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Wrong host (bare domain, old alias, IP) -> canonical host over HTTPS.
  # (:port tolerated — Host carries a port on non-default ports / odd proxies.)
  RewriteCond %{HTTP_HOST} !^www\.sporta\.com\.kw(:[0-9]+)?$ [NC]
  RewriteRule ^ https://www.sporta.com.kw%{REQUEST_URI} [R=301,L]

  # 2) Right host, plain HTTP -> HTTPS. Hostinger terminates SSL at a proxy, so
  #    Apache often sees plain HTTP even for real HTTPS hits. Redirect ONLY when
  #    every signal says insecure — if one is missing we serve the page instead
  #    of risking an infinite http->https->http loop.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP:X-Forwarded-SSL} !=on
  RewriteCond %{SERVER_PORT} !=443
  RewriteRule ^ https://www.sporta.com.kw%{REQUEST_URI} [R=301,L]
</IfModule>

# ---- One URL per page (kill duplicates without adding redirect hops) ----
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # /index.html -> / . Guarded by THE_REQUEST, which keeps the ORIGINAL request
  # line even after an internal rewrite, so the SPA rewrite below (which targets
  # /index.html internally) can never re-enter this rule and loop.
  # Target is the ABSOLUTE canonical URL, not "/": behind Hostinger's SSL-
  # terminating proxy Apache sees plain HTTP, so a path-only target would be
  # expanded to http:// and bounce through the HTTPS rule = 2 hops.
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ https://www.sporta.com.kw/ [R=301,L]

  # /shop/ -> /shop . Canonicals and internal links never use a trailing slash;
  # this stops the slashed spelling becoming a second indexable URL.
  # !-d keeps real directories (/assets/) working.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+?)/+$ https://www.sporta.com.kw/$1 [R=301,L]
</IfModule>

# ---- SPA routing: send non-file requests to index.html ----
# This is an INTERNAL rewrite (no R flag): the browser keeps /shop in the URL
# bar and no redirect is issued, so deep links cost zero hops.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# ---- HSTS: tell browsers to always use HTTPS for this domain ----
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ---- Compression (Brotli if available, else gzip) ----
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css application/json application/javascript text/javascript image/svg+xml application/xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/json application/javascript text/javascript image/svg+xml application/xml
</IfModule>

# ---- Caching ----
<IfModule mod_expires.c>
  ExpiresActive On

  # Hashed build assets (index-AbC123.js/css) never change → cache 1 year.
  <FilesMatch "\.(js|css|woff2?|ttf|eot|svg|png|jpe?g|gif|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML must always revalidate so users get new deploys immediately.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
    ExpiresByType text/html "access plus 0 seconds"
  </FilesMatch>
</IfModule>

# ---- Basic security headers ----
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
