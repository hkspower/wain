{
  "name": "sporta-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "seo": "node scripts/generate-seo.mjs",
    "bundle:php": "node scripts/bundle-php.mjs",
    "release": "npm run seo && npm run build && npm run bundle:php && node scripts/sw-precache.mjs",
    "deploy": "node dropin/scripts/deploy.mjs",
    "build:html5": "node scripts/generate-seo.mjs && node scripts/build-html5.mjs",
    "audit:files": "node scripts/file-audit.mjs",
    "audit:storage": "node scripts/storage-audit.mjs",
    "test:areas": "node scripts/kuwait-areas-test.mjs",
    "test:perf": "node scripts/perf-budget-test.mjs",
    "test:a11y": "node scripts/a11y-pwa-test.mjs",
    "test:uploader": "node scripts/image-uploader-test.mjs",
    "test:images": "node scripts/image-budget-test.mjs",
    "test:checkout": "node scripts/checkout-mobile-test.mjs",
    "package": "node scripts/make-package.mjs",
    "publish": "node scripts/publish-ftps.mjs",
    "publish:dry": "node scripts/publish-ftps.mjs --dry-run",
    "publish:watch": "node scripts/publish-watch.mjs",
    "ftp:doctor": "node scripts/ftp-doctor.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "basic-ftp": "^6.0.2",
    "dotenv": "^17.4.2",
    "playwright": "^1.61.1",
    "postcss": "^8.5.22",
    "ssh2-sftp-client": "^12.1.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.5"
  }
}
