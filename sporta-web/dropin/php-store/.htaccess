# public_html/api/ — the native backend.
#
# <FilesMatch> because it is inherited into subdirectories and RewriteRule is
# not — the measured lesson in SERVER-LAYOUT.md. Deny by NAME.

# The credentials. config.php holds the MySQL password; store.php and the .sql
# files are includes and import fixtures, not endpoints — nothing loses by
# denying them, and seed.mysql.sql names every product and cost price.
# catalogue.php, site-icon.php and product-listable.php only define functions: requested directly they answered 200 with an empty body (2026-11-19),
# which is not a secret but is not an endpoint either.
<FilesMatch "^(config\.php|config\.example\.php|store\.php|seo-config\.php|seo-runtime\.php|crm\.php|returns\.php|cron-auth\.php|customer-auth\.php|preflight\.php|setup-admin\.php|catalogue\.php|site-icon\.php|product-listable\.php|.*\.sql)$">
  Require all denied
</FilesMatch>

# Include-only files: they define functions, constants or a returned array and nothing else. Requested directly they
# answered 200 with an empty body (measured 2026-11-19 by including each file with a GET and counting the output).
# Nothing routes to them: api.php, seo-page.php, the sitemaps and the cron jobs reach them with require, and no client
# file fetches them (the names in public/ are comments). db-pool.php answered 404 by its own guard; it is listed here too.
<FilesMatch "^(apple-lib|assistant|assistant-faq|dbcenter|dbcenter-manifest|db-pool|fabric|payment-records|photo-library|photo-limits|profiles|support|xbrl)\.php$">
  Require all denied
</FilesMatch>

# JSON answers are per-request state. Never cache an order status.
<IfModule mod_headers.c>
  Header set Cache-Control "no-store"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "no-referrer"
  Header set Cross-Origin-Resource-Policy "same-origin"
</IfModule>

Options -Indexes

# config-path.php is an include, never an endpoint (answered 200 empty).
<Files "config-path.php">
  Require all denied
</Files>

# The storefront HTML (/, /shop, /product/…) is rendered by seo-page.php, so the
# no-store above swallowed its own "no-cache" and the homepage was re-downloaded
# on every visit. A successful page may be kept and revalidated (seo-page.php
# sends an ETag, so an unchanged page is a 304); its 304 must carry the same header (a 304 updates the stored copy's
# headers, so no-store there would evict it); a 503/404 stays no-store.
<Files "seo-page.php">
  Header set Cache-Control "no-cache, stale-while-revalidate=60" "expr=%{REQUEST_STATUS} == 200 || %{REQUEST_STATUS} == 304"
</Files>

# Hero slides, brand logos and the site icon (favicon) are IMAGES served by api.php, each URL carrying
# its content hash (&v=), and api.php sends "public, max-age=31536000,
# immutable" for them. The blanket no-store above REPLACED that header, so
# every visitor re-downloaded all seven hero photos (~1 MB) on every visit —
# measured live 2026-11-02. Only a successful answer to exactly those three
# routes gets the year; everything else from api.php stays no-store (a 404 for a
# stale icon version stays no-store too).
<Files "api.php">
  Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{QUERY_STRING} =~ /(^|&)r=(slide_image|brand_logo|site_icon)(&|$)/ && %{QUERY_STRING} !~ /%|(^|&)r=[^&]*&(.*&)?r=/ && %{REQUEST_STATUS} == 200"
  # The live catalogue (?r=catalogue) sends an ETag and "no-cache": the page polls it with If-None-Match and a 304 must keep that header (a 304
  # updates the stored copy's headers, so no-store there would evict it). A 200 or 304 only: an error (429, 405, 500) stays no-store above.
  # SP-1 (review 2026-11-19): PHP reads the LAST r (and decodes %72= to r), Apache's query string is raw, so a URL naming r=catalogue first and another
  # route last (?r=catalogue&r=invoice&..., ?r=catalogue&%72=status) used to get "no-cache" (or the site_icon year, "immutable") on an answer that carries
  # an order. Both exceptions now stand aside for a query string with a percent sign or a second r: the blanket no-store above stays.
  Header set Cache-Control "no-cache" "expr=%{QUERY_STRING} =~ /(^|&)r=catalogue(&|$)/ && %{QUERY_STRING} !~ /%|(^|&)r=[^&]*&(.*&)?r=/ && (%{REQUEST_STATUS} == 200 || %{REQUEST_STATUS} == 304)"
</Files>

# /sitemap.xml and /sitemap-products.xml are rewritten (root .htaccess) to these
# two scripts, so they inherited the no-store above — and lost the hour's
# freshness the static files had (measured by scripts/live-scan.mjs: no-store).
# Crawlers fetch them repeatedly and they change only when the catalogue does:
# the same tier as robots.txt. Errors stay no-store.
<FilesMatch "^sitemap-(index|products)\.php$">
  Header set Cache-Control "public, max-age=3600, stale-while-revalidate=86400" "expr=%{REQUEST_STATUS} == 200 || %{REQUEST_STATUS} == 304"
</FilesMatch>

# birthday-lib.php is an include, never an endpoint.
<Files "birthday-lib.php">
  Require all denied
</Files>

# config.example.php is a template for private/api-config.php. It holds no secrets,
# but it is a map of every configuration key and what each controls, so the web
# has no reason to read it. Denied by NAME (a FilesMatch survives where a
# RewriteRule would not). Added 2026-10-31.
<Files "config.example.php">
    Require all denied
</Files>

# Editor and manual backups (config.php~, x.php.bak, …) are never served: a backup of a credential file
# answered as text is a leak (review finding, high). Deny by NAME, per folder.
<FilesMatch "(?i)(~|\.(bak|orig|old|save|swp))$">
  Require all denied
</FilesMatch>

# PHP limits for product photo uploads (admin.php product_image_upload). The route takes a photograph of up to
# 10 MiB, sent as base64 inside a JSON body of about 13.4 MB, and refuses above 14 MiB of body text. The server's
# own defaults cut that off before the route ran, so a normal camera photo could not be uploaded. (The live values
# were not read when this was written; PHP's stock defaults are 2 MB per file and 8 MB per request.) post_max_size must cover the whole body; memory_limit covers the decode and the size check.
# Set here, per directory, because PHP reads these at request time (PHP_INI_PERDIR): the VPS has no php.ini.
# The IfModule guard keeps the folder working on a server whose PHP is not the Apache module.
<IfModule mod_php.c>
  php_value upload_max_filesize 16M
  php_value post_max_size 24M
  php_value memory_limit 256M
</IfModule>
<IfModule mod_php8.c>
  php_value upload_max_filesize 16M
  php_value post_max_size 24M
  php_value memory_limit 256M
</IfModule>
