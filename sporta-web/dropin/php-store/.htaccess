# public_html/api/ — the native backend.
#
# <FilesMatch> because it is inherited into subdirectories and RewriteRule is
# not — the measured lesson in SERVER-LAYOUT.md. Deny by NAME.

# The credentials. config.php holds the MySQL password; store.php and
# schema.mysql.sql are includes, not endpoints — nothing loses by denying them.
<FilesMatch "^(config\.php|config\.example\.php|store\.php|schema\.mysql\.sql|seed\.mysql\.sql)$">
  Require all denied
</FilesMatch>

# JSON answers are per-request state. Never cache an order status.
<IfModule mod_headers.c>
  Header set Cache-Control "no-store"
</IfModule>

Options -Indexes
