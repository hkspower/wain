# Copy to ".env.deploy" in your project root. NEVER commit it.
# Add ".env.deploy" (and ".env*") to .gitignore.

# Password auth (simplest):
HOSTINGER_SSH_PASSWORD=your-ssh-password

# --- OR key auth (recommended). If set, the key is used instead of password ---
# HOSTINGER_SSH_KEY_PATH=~/.ssh/id_ed25519
# HOSTINGER_SSH_PASSPHRASE=only-if-your-key-is-encrypted

# Host/port/user/remoteDir come from deploy.config.json (ssh.*), not here.
