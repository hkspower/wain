# Hostinger deploy credentials — copy to ".env" in your project root.
# NEVER commit .env. Add ".env" to .gitignore.

# ftp | ftps | sftp   (sftp recommended; Hostinger SSH/SFTP port is usually 65002)
HOSTINGER_DEPLOY_MODE=sftp

HOSTINGER_HOST=46.202.158.211
HOSTINGER_USER=u130124229
HOSTINGER_PASSWORD=your-password-here

# Port: 65002 for Hostinger SFTP, 21 for FTP/FTPS. Leave unset to use the
# default for the chosen mode (22 for sftp, 21 for ftp/ftps).
HOSTINGER_PORT=65002

# Where the site lives on the server, and which local folder to upload.
HOSTINGER_REMOTE_DIR=/public_html
HOSTINGER_LOCAL_DIR=dist

# Optional: SFTP key auth instead of password (path to private key file).
# If the key has a passphrase, put it in HOSTINGER_PASSWORD.
# HOSTINGER_PRIVATE_KEY=~/.ssh/id_ed25519
