# Copy to .env only if you need to point a LOCAL build somewhere unusual.
#
# You almost certainly do not need this file. Every value below has a working
# default, and the deployed site configures itself at runtime from
# public_html/config.js — which is the whole reason the shop can be repointed
# in hPanel File Manager with no Node and no rebuild.
#
# Vite only exposes vars prefixed with VITE_ to the client, and nothing secret
# belongs here: these are public URLs. The database password, the Tranportal
# credentials and the CBK keys live in config.php files on the server and
# nowhere else.

# The backend. Default: /api on the same origin.
VITE_PHP_API_URL=

# Payment endpoints on Hostinger. Classic KNET (KPG) = /knet, T-Pay = /pay.
VITE_PAY_BASE_URL=https://www.sporta.com.kw/knet
VITE_CBK_BASE_URL=https://www.sporta.com.kw/pay
