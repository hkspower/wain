# Copy to .env and fill in your Supabase project values.
# Vite only exposes vars prefixed with VITE_ to the client.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Payment endpoints on Hostinger. Classic KNET (KPG) = /knet.
VITE_PAY_BASE_URL=https://www.sporta.com.kw/knet
