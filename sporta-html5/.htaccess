# Sporta — Hostinger (Apache) production config: SPA routing + compression + caching.

# ---- Canonicalise host + scheme in a SINGLE 301 (never chain redirects) ----
# Everything on the site declares https://www.sporta.com.kw as canonical, so any
# other spelling of the URL jumps straight there in one hop. Rule 1 fixes host
# AND scheme together, so http://sporta.com.kw/x is ONE redirect, not two.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Wrong host (bare domain, old alias, IP) -> canonical host over HTTPS.
  # (:port tolerated — Host carries a port on non-default ports / odd proxies.)
  RewriteCond %{HTTP_HOST} !^www\.sporta\.com\.kw(:[0-9]+)?$ [NC]
  RewriteRule ^ https://www.sporta.com.kw%{REQUEST_URI} [R=301,L]

  # 2) Right host, plain HTTP -> HTTPS. Hostinger terminates SSL at a proxy, so
  #    Apache often sees plain HTTP even for real HTTPS hits. Redirect ONLY when
  #    every signal says insecure — if one is missing we serve the page instead
  #    of risking an infinite http->https->http loop.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP:X-Forwarded-SSL} !=on
  RewriteCond %{SERVER_PORT} !=443
  RewriteRule ^ https://www.sporta.com.kw%{REQUEST_URI} [R=301,L]
</IfModule>

# ---- Compression (Brotli if available, else gzip) ----
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css application/json application/javascript text/javascript image/svg+xml application/xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/json application/javascript text/javascript image/svg+xml application/xml
</IfModule>

# ---- Caching ----
<IfModule mod_expires.c>
  ExpiresActive On

  # This site has NO build step, so app.js / style.css / products.js keep the
  # same filename forever. Marking them immutable would pin a whole year of
  # stale JS, CSS and PRICES into returning visitors' browsers after a deploy.
  # They revalidate instead — the ETag makes that a cheap 304.
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Images and fonts are also fixed-name, so cache them for a month but never
  # immutable — a replaced logo then propagates without renaming the file.
  <FilesMatch "\.(woff2?|ttf|eot|svg|png|jpe?g|gif|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # HTML must always revalidate so users get new deploys immediately.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
    ExpiresByType text/html "access plus 0 seconds"
  </FilesMatch>
</IfModule>

# ---- Basic security headers ----
# ---- HSTS: after the first visit browsers go straight to HTTPS, so the
# http -> https redirect above stops being issued at all. ----
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Cross-Origin-Opener-Policy "same-origin"
  Header set X-Permitted-Cross-Domain-Policies "none"
  Header always unset X-Powered-By
  Header set Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), xr-spatial-tracking=()"

  # 'unsafe-inline' in script-src is unavoidable here: every page carries an
  # inline <script> block (page logic + JSON-LD) and there is no build step to
  # hash or nonce them. The policy still blocks third-party script hosts,
  # <object>/<embed>, <base> hijacking and cross-origin framing.
  Header set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline'; connect-src 'self'; form-action 'self' https://kpay.com.kw https://kpaytest.com.kw; upgrade-insecure-requests"
</IfModule>

# ---- Branded, bilingual 404 instead of Apache's default error page ----
ErrorDocument 404 /404.html

# ---- Never serve VCS metadata, env files, manifests or backups ----
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule "(?i)(^|/)\.(?!well-known)" - [F,L]
</IfModule>
<FilesMatch "(?i)^(composer\.(json|lock)|package(-lock)?\.json|yarn\.lock|pnpm-lock\.yaml|.*\.(bak|old|orig|save|swp|sql|log|sh|env))$">
  Require all denied
</FilesMatch>

ServerSignature Off
