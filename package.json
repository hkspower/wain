{
  "name": "wain",
  "version": "1.0.0",
  "private": true,
  "description": "Wain (وين) — Discover where to go in Kuwait. A modern place-discovery app.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "hub": "node server/hub-server.mjs",
    "build:mobile": "NEXT_OUTPUT=export next build",
    "mobile:sync": "npm run build:mobile && npx cap sync",
    "mobile:ios": "npm run mobile:sync && npx cap open ios",
    "mobile:android": "npm run mobile:sync && npx cap open android",
    "build:steam": "NEXT_OUTPUT=export next build && rm -rf desktop/out && cp -r out desktop/out",
    "sync:unreal": "node scripts/export-unreal-data.mjs",
    "check:unreal": "node scripts/check-unreal-sync.mjs",
    "sync:models": "node scripts/export-car-profiles.mjs && python3 tools/blender/build_assets.py --out public/models",
    "sync:unity": "node scripts/export-unity-data.mjs",
    "check:unity": "node scripts/check-unity-sync.mjs",
    "check:arabic": "node scripts/check-arabic.mjs",
    "test:motion": "node tests/motion.mjs",
    "test:pacing": "node tests/framepacing.mjs",
    "test:assets": "node tests/assets.mjs",
    "test:physics": "node tests/physics.mjs",
    "sfx": "node tools/elevenlabs/generate-sfx.mjs",
    "music": "node tools/elevenlabs/generate-music.mjs",
    "audio:check": "node tools/elevenlabs/check-all.mjs",
    "sfx:verify": "node tools/elevenlabs/verify-sfx.mjs",
    "shots": "node tools/shots/capture.mjs",
    "test:race": "node tests/fullrace.mjs",
    "test:fonts": "node tests/fonts.mjs",
    "test:mods": "node tests/mods.mjs",
    "test:topspeed": "node tests/topspeed.mjs",
    "test:vfx": "node tests/vfx.mjs",
    "test:audio": "node tests/audio.mjs",
    "test:daynight": "node tests/daynight.mjs",
    "test:ik": "node tests/ik.mjs",
    "test:menu": "node tests/menu.mjs",
    "test:grade": "node tests/grade.mjs",
    "test:streets": "node tests/streets.mjs",
    "shots:cars": "node tools/shots/cars.mjs",
    "check:ui": "node scripts/check-ui-glyphs.mjs",
    "check:parts": "node scripts/check-catalogue.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@types/three": "^0.184.1",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.184.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3"
  }
}
