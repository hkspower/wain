# Nokha1 — Apache / LiteSpeed config (Hostinger and most shared hosts).
# GitHub Pages ignores this file, so it is safe to ship everywhere.

# ---- Correct MIME types (a wrong type silently breaks PWA install) ----
AddType application/manifest+json .webmanifest
AddType image/svg+xml            .svg
AddType text/javascript          .js
AddType font/woff2               .woff2

<IfModule mod_headers.c>
  # ---- HTTP/3 (QUIC) ----
  # The protocol is negotiated by the SERVER, not by these files. This header is
  # the advertisement: it tells a browser that arrived over HTTP/1.1 or HTTP/2
  # that the same origin is reachable over HTTP/3 on UDP/443, so the next request
  # races a QUIC connection. LiteSpeed (Hostinger) and Cloudflare emit this
  # themselves once QUIC is enabled; setting it here covers hosts that don't.
  #
  # Only keep this if the host actually serves HTTP/3 — advertising h3 on a
  # server without it makes browsers attempt a QUIC handshake that must time out
  # before falling back. Verify with design/check-http3.sh, and delete this block
  # if the check reports no h3.
  Header always set Alt-Svc "h3=\":443\"; ma=86400"

  # ---- Security headers ----
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

  # ---- The service worker must never be cached, or updates never reach users ----
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Service-Worker-Allowed "/"
  </FilesMatch>

  # HTML is revalidated every time; the service worker handles offline speed.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(svg|webmanifest)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ---- Force HTTPS (service workers require it) ----
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # ---- Extensionless URLs for the products living inside the company site ----
  # /nokha1 -> nokha1.html, /nizam -> nizam.html, /editor -> editor.html.
  # Rewritten, not redirected, so the address bar keeps the clean form.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(nokha1|nizam|editor|admin|safi|xbrl|delivery)/?$ $1.html [L]

  # ---- Canonical host: send the bare domain to www ----
  RewriteCond %{HTTP_HOST} ^almuhallab-code\.com$ [NC]
  RewriteRule ^(.*)$ https://www.almuhallab-code.com/$1 [R=301,L]
</IfModule>

# ---- Friendly 404 that returns visitors to the portal ----
ErrorDocument 404 /404.html

# ---- Compression ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/manifest+json image/svg+xml
</IfModule>

# ---- Don't serve repo docs from the web root ----
<FilesMatch "\.(md|yml)$">
  Require all denied
</FilesMatch>
