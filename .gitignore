*.tsbuildinfo

example

# generated native folders
/ios
/android

# expo web export output
/dist

# Local test rig only — real credentials live on the server and are never here.
sporta-site/public_html/api/config.php
sporta-site/public_html/knet/config.php
sporta-site/public_html/pay/config.php

# Wallet signing material and built passes — the certificate is the shop's
# identity to Apple and must never be in a repository.
wallet/certs/
wallet/.build/
wallet/*.pkpass
wallet/*-UNSIGNED.zip
/wallet-certs/

# Payment and assistant logs. They live one directory above public_html on the
# real server for a reason — they are not servable — and in the sandbox they
# land inside sporta-site/ where git would otherwise offer to commit a file
# containing upstream error text and, in the payment case, order references.
sporta-site/*.log
sporta-voice.log
cbk-payments.log
