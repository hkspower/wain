# python
__pycache__/
*.pyc

# car elevations rendered on demand by tools/shots/car-views.mjs
/press/views/

# decal artwork dumped on demand by tools/shots/decals.mjs
/press/decals/

# level histograms + frames, regenerated by tools/shots/levels.mjs
/press/levels/

# shop screenshots, regenerated by tools/shots/shop.mjs
/press/shop/

# overhead grid shots, regenerated by tools/shots/grid.mjs
/press/grid/

# situation grade frames, regenerated by tools/shots/situations.mjs
/press/situations/

# glare falloff frames, regenerated by tools/shots/glare.mjs
/press/glare/

# dark-area scan frames, regenerated by tools/shots/dark.mjs
/press/dark/

# clock screenshots, regenerated on demand
/press/clock/

# edge-quality frames, regenerated by tools/shots/edges.mjs
/press/edges/

# area-guide plate shots, regenerated on demand
/press/areas/

# station shots, regenerated on demand
/press/station/

# framing frames, regenerated by tools/shots/framing.mjs
/press/framing/

# roadside planting frames, regenerated on demand
/press/plants/

# rev-limiter alert frames, regenerated on demand
/press/limiter/

# exhaust tip frames, regenerated on demand
/press/exhaust/

# the hub's referral ledger — live player data, written by the server
/server/data/

# Intermediate frames from tools/shots/exportfilm.mjs — the encoded
# video beside them is the artefact; 336 JPEGs are not.
press/film/frames/
press/audio/capture/

# Full-page captures of the website, written by npm run check:site on
# every run. press/shots/*.png is otherwise COMMITTED on purpose — those
# are the reference stills you flick between to see what a change did to
# the picture — but these two are 5 MB of check output that changes with
# every word of copy, and nothing compares them to anything.
press/shots/site-en.png
press/shots/site-ar.png

# The lifted car renders the Story cards are built from. Derived by
# npm run stories:images from press/cars/, and inlined into
# press/stories/stories.html anyway — the HTML and the PNGs beside it
# are the deliverable and they ARE committed; this is the scratch step
# in between.
press/stories/img/

# Frames from tools/shots/tint.mjs. Fifteen 540 KB captures of the same
# car at different darknesses, regenerated every time the tool runs; the
# TABLE it prints is the artefact, not the pictures it measured.
/press/tint/

# Dev server output, when it is redirected into the repo for tailing.
dev.log
*.log

# Scratch scripts from an investigation. These get written at the repo
# root rather than in a scratch directory for one boring reason: a file
# outside the project cannot resolve playwright-core from node_modules,
# so a browser probe has to live here to run at all. One of them,
# shot3-tmp.mjs, was committed by accident and sat in the tree for
# weeks. The pattern is the fix, so the next one cannot.
*-tmp.mjs
*-tmp.js
*-tmp.py
