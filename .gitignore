# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/

# production
/build

# hand-off archives built from out/ and from the repo itself
/wain-deploy.zip
# versioned release archives from `npm run release`
/wain-*.zip
/wain-*.zip.sha256
/wain-source.zip
# ...and the same archive under a name the server will actually serve. Both
# docroots on the account deny `.zip` in .htaccess, so an artifact uploaded
# there has to carry a different extension — deploy.php reads the bytes with
# ZipArchive and never looks at the name. Ignored by EXTENSION rather than by
# the one name in use: this is the third time an archive has been ignored by a
# specific spelling and appeared again under another, and 25MB of this history
# is the bill for the first two.
/wain-*.bin

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

# vercel
.vercel

# Seeded design canvas — 2.2MB of bundled editor code, regenerated from the
# .dc.html artboards beside it. The artboards are the source; this is output.
design/**/*.html
!design/**/*.dc.html
.preview-cache/

# Claude Design canvases. The .dc.html artboards and canvas.json ARE the
# source and are tracked; the seeded output beside them is a 2.5MB copy of
# the canvas editor with that source embedded, regenerated on every change.
.design/**/wain-*.html

# Originals for the photo pipeline — the web-sized output in public/photos/
# is committed, these are not. See src/lib/photos.ts.
photos-src/

# The full-site PDF is a rendered artefact, regenerated on demand.
wainkw-site.pdf

# `npm run deploy:plan` writes this; it is a reading of one build, not source.
/deploy-plan.json
