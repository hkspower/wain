# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# expo web export output
/dist

# Local test rig only — real credentials live on the server and are never here.
sporta-site/public_html/api/config.php
sporta-site/public_html/knet/config.php
sporta-site/public_html/pay/config.php

# Wallet signing material and built passes — the certificate is the shop's
# identity to Apple and must never be in a repository.
wallet/certs/
wallet/.build/
wallet/*.pkpass
wallet/*-UNSIGNED.zip
/wallet-certs/

# Payment and assistant logs. They live one directory above public_html on the
# real server for a reason — they are not servable — and in the sandbox they
# land inside sporta-site/ where git would otherwise offer to commit a file
# containing upstream error text and, in the payment case, order references.
sporta-site/*.log
sporta-voice.log
cbk-payments.log

# Upload packages. Build output — `zip -r` over public_html — and megabytes of
# it per build, all of it already in the repo as the files it was made from.
# Committing one would mean a binary that goes stale the moment anything under
# public_html changes, and no way to see that it had.
#
# A PATTERN, not three names. It was a list, and every hand-off zip with a new
# name — BRAND-FOLDERS.zip was the second — arrived as an untracked file and
# had to be added by hand. Anything shaped like a package is build output;
# nothing tracked here is a .zip.
#
# UNANCHORED, because the leading slash meant "repo root only" and the packages
# are built next to what they contain — sporta-site/SPORTA-BACKEND.zip and two
# others were committed by a `git add -A` before anyone noticed the rule had
# not covered them. That is the failure this block was already written to
# prevent; it was just spelled too narrowly to do it.
*.zip

# Scratch probes. Every session writes scripts/_probe.mjs to measure something
# once; one of them was committed. The leading underscore is the convention and
# package-check.mjs already refuses files matching it inside the docroot.
scripts/_*.mjs
scripts/_*.py

# Archived invoice PDFs. Customer names and addresses, one file per order —
# written by api/cron-invoice.php to a folder BESIDE public_html so no URL
# reaches them. They must not reach a git history either: a repository is
# copied, cloned and zipped far more casually than a server is, and an invoice
# is personal data with no expiry.
#
# The path here matches invoice_dir()'s default, which resolves to
# <docroot>/../invoices — sporta-site/invoices in this checkout.
sporta-site/invoices/

# The recovery bundle written during an incident. htaccess-RESTORE.txt is a
# copy of a file already tracked here, and the README beside it is a note to
# one person on one day — neither belongs in the history.
sporta-site/RESTORE/

# One-shot installers. sporta-fix.php carries base64 copies of files that are
# already tracked here, plus the hash of a key that is handed over out of band
# — build output for a blocked upload channel, in the same sense the zips above
# are, and stale the moment any file it carries changes. It is generated, used
# once on the server, and deletes itself.
# A PATTERN, not one name: sporta-assets.php was the second of these and
# arrived untracked, exactly as the zips did before the rule above them was
# widened. No tracked file matches sporta-*.php.
sporta-*.php
