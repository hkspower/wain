# ملف بيئة نظام موصول — انسخه إلى .env واملأه قبل التشغيل الفعلي
#   cp .env.example .env
# لا ترفع .env إلى git أبدًا.

# ————————————————————————— الخادم —————————————————————————

PORT=4000
HOST=127.0.0.1

# اجعلها 1 خلف HTTPS (إلزامي في التشغيل الفعلي):
# بدونها ترسل الكوكيز بلا علم Secure، وتحديد الموقع والميكروفون لا يعملان أصلًا
# إلا في سياق آمن.
MAWSOOL_SECURE_COOKIE=1

# ———————————————————————— قاعدة البيانات ————————————————————————

MAWSOOL_DATA_DIR=data
MAWSOOL_DB=data/mawsool.db

# ————————————————————————— قواعد التشغيل —————————————————————————

# سقف الطلبات النشطة للكابتن تحت التجربة (0 = بلا سقف)
MAWSOOL_PROBATION_MAX_ORDERS=3

# مدة صلاحية رابط المهمّة بالساعات
MAWSOOL_LINK_HOURS=12

# مدة الاحتفاظ بنقاط الموقع بالساعات — كلما قلّت كان أفضل للخصوصية
MAWSOOL_LOCATION_RETENTION_HOURS=24

# حدّ حجم الملاحظة الصوتية بالبايت (4 م.ب)
MAWSOOL_VOICE_MAX_BYTES=4194304

# ——————————————————————— بريد تقارير المهام ———————————————————————
# بدون هذه القيم تُحفظ التقارير في «الإعدادات ← صادر البريد» ولا تصل أحدًا.

MAWSOOL_SMTP_URL=smtp://user:password@smtp.example.com:587
MAWSOOL_MAIL_TO=ops@mawsool.com.kw
MAWSOOL_MAIL_FROM=no-reply@mawsool.com.kw
