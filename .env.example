# شوق — ElevenLabs Conversational AI agent ID (public; safe in a static build).
# Without it شوق still answers from the built-in data; only the live voice
# agent mode is switched off.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# Admin panel backend (Supabase). Without these the site runs exactly as it
# does today from its built-in data, and /admin explains what is missing.
# The anon key is public by design — row level security is what protects the
# data. NEVER put the service_role key here; it bypasses RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
