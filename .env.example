# Build-time switches. Every NEXT_PUBLIC_ value is baked into the bundle at
# build, so a deploy that leaves one wrong cannot be corrected afterwards.
#
# An empty value is the same as unset (every variable is read with ||, see
# src/lib/wain-ai.ts for why ?? was wrong). Unset = OFF for the two agent ids and
# the voice bridge; unset = the default named below for the back end, the media
# endpoint and the map tiles. `none` switches a feature off where it says so.

# شوق — her own ElevenLabs Conversational AI agent (public id, safe in a static
# build). Unset or `none` switches off HER calls and her answers' voice agent
# only; she still answers from the built-in data.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# سالم — his own agent, separate from hers. Nothing falls back from one id to
# the other: unset or `none` switches off his typed chat and his call alone.
NEXT_PUBLIC_ELEVENLABS_SALEM_AGENT_ID=

# wain's own back end (orders, the queue, registration, live place edits).
# Unset = /api/wain.php on the site's origin. `none` = off, and /admin says so.
# A full https URL = the endpoint an app bundle, which has no origin, should call.
NEXT_PUBLIC_WAIN_BACKEND=

# صوت وين's voice bridge. Unset or `none` = off, and answers are read by the
# browser's own Arabic voice (the default since the endpoint was closed on
# 15 October 2026). To reopen it, reinstall the endpoint first, then build with
# /api/tts.php here, and name any other host in the CSP in public/.htaccess.
NEXT_PUBLIC_WAIN_TTS_URL=

# Business-registration photo upload. Unset = /api/media.php on the site's origin.
NEXT_PUBLIC_WAIN_MEDIA_URL=

# Live-map tile template. Unset = OpenStreetMap. `none` = no live map. A new
# tile host has to join img-src in public/.htaccess in the same sitting.
NEXT_PUBLIC_WAIN_TILES=

# `1` shows the drawn stand-ins of معالم الكويت in a PREVIEW build. Never set it
# for a deploy: deploy:plan refuses an archive that carries one.
NEXT_PUBLIC_SHOW_STANDINS=
