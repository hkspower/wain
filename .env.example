# Copy to .env.local (gitignored). Every value is optional.

# The multiplayer hub the web build connects to (server/hub-server.mjs).
NEXT_PUBLIC_HUB_WS=

# Where the web build loads its static assets from — models, music,
# voices, effects, card images. Unset, the game serves them from its own
# public/ (dev, the mobile bundle and the Steam build must leave it
# unset). Production web: https://nr.mawsoool.com. See src/game/cdn.ts.
NEXT_PUBLIC_ASSET_BASE=

# Credentials for npm run deploy:assets, from Hostinger's upload-URL API
# for the mawsoool.com website. Short-lived; export them in the shell for
# one run rather than keeping them in a file.
NR_UPLOAD_URL=
NR_UPLOAD_AUTH=
NR_UPLOAD_AUTH_REST=
