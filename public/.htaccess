# Wain — static export on Apache / LiteSpeed (Hostinger)
#
# Next.js `output: 'export'` with `trailingSlash: true` writes each route as a
# directory containing index.html, so no rewrite-to-index catch-all is needed
# — and must NOT be added, as it would mask real 404s.

ErrorDocument 404 /404.html
DirectoryIndex index.html

# Never serve this file itself.
<Files ".htaccess">
  Require all denied
</Files>

# Directories without an index.html — /_next/static/chunks/ and friends —
# must not answer with a file listing. Usually off at the host, but "usually"
# is not a setting.
Options -Indexes

# Dotfiles are never content here.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# ---------------------------------------------------------------------------
# Caching
#
# Two classes of file, and they need opposite policies:
#
#   1. /_next/static/**  — every .js, .css and .woff2 carries a content hash in
#      its filename, so a changed file is a *different URL*. These can be
#      cached for a year and never revalidated. `immutable` also stops browsers
#      re-checking them on reload.
#
#   2. Everything else — index.html, og.png, sitemap.xml … keep stable names,
#      so they must revalidate or a deploy would be invisible to returning
#      visitors. `no-cache` still allows 304s via ETag: cheap when unchanged,
#      correct when changed.
#
# A build guard (scripts/check-cache-safety.mjs) fails the build if an
# unhashed .js/.css/.woff2 ever appears outside /_next/static/, which would
# make the immutable rule below unsafe.
# ---------------------------------------------------------------------------

<IfModule mod_headers.c>
  # 1. Content-hashed build output — cache hard, forever.
  <FilesMatch "\.(js|mjs|css|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # 1b. The service worker is the one unhashed .js we ship, and it decides
  # which build every installed app runs. It must never be frozen by rule 1,
  # so this comes after it and wins.
  <Files "sw.js">
    Header set Cache-Control "public, max-age=0, must-revalidate"
    Header set Service-Worker-Allowed "/"
  </Files>

  # 2a. HTML and the RSC payloads beside it — always revalidate.
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # 2b. Stable-named media (incl. صوت وين clips) — a week in cache, then
  # revalidate.
  <FilesMatch "\.(png|jpg|jpeg|webp|avif|svg|ico|mp3)$">
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
  </FilesMatch>

  # 2c. Crawler and install metadata — short, so changes propagate quickly.
  <FilesMatch "\.(xml|webmanifest|json)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # Never let a proxy serve the wrong encoding.
  Header append Vary Accept-Encoding
</IfModule>

# Fallback for hosts without mod_headers.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                      "access plus 1 hour"
  ExpiresByType text/html             "access plus 0 seconds"
  ExpiresByType text/css              "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2            "access plus 1 year"
  ExpiresByType font/woff             "access plus 1 year"
  ExpiresByType image/png             "access plus 1 week"
  ExpiresByType image/svg+xml         "access plus 1 week"
  ExpiresByType image/x-icon          "access plus 1 week"
  ExpiresByType audio/mpeg            "access plus 1 week"
</IfModule>

# ---------------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------------

# Brotli first where available — noticeably smaller than gzip for text.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml \
    application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# woff2 is already compressed; re-compressing wastes CPU and can grow it.
<IfModule mod_setenvif.c>
  SetEnvIfNoCase Request_URI \.(woff2?|png|jpe?g|webp|avif|ico)$ no-gzip dont-vary
</IfModule>

# ---------------------------------------------------------------------------
# Correct types (some hosts do not know these by default)
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
</IfModule>

# ---------------------------------------------------------------------------
# Baseline security headers
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # فهد needs the microphone; nothing else on the site needs these features.
  Header set Permissions-Policy "camera=(), geolocation=(self), microphone=(self)"

  # Nobody has any business framing this site. /admin is a real session behind
  # this, so being framable is a clickjacking route into it. frame-ancestors is
  # the modern control; X-Frame-Options covers browsers that predate it.
  Header set X-Frame-Options "DENY"

  # The site is HTTPS-only on Hostinger. Deliberately without includeSubDomains
  # and without preload: both are hard to walk back, and a subdomain that is
  # not yet on HTTPS would become unreachable for a year. Add them once every
  # subdomain is confirmed HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000"

  # Content Security Policy.
  #
  # Honest about its limits: 'unsafe-inline' has to stay in script-src because
  # Next.js inlines its hydration payload and a static export has no server to
  # mint a per-request nonce. So this is not a strong defence against injected
  # inline script. What it does buy, and what the site actually needs:
  #
  #   * script-src pins executable code to this origin and unpkg (فهد's widget)
  #     — nothing else can be loaded, whatever ends up in the DOM.
  #   * frame-ancestors 'none' blocks clickjacking of /admin.
  #   * form-action 'self' stops an injected form posting credentials offsite.
  #   * base-uri 'self' stops a <base> tag re-pointing every relative URL.
  #   * object-src 'none' removes the plugin surface entirely.
  #   * connect-src names Supabase and ElevenLabs explicitly, so exfiltration
  #     to an arbitrary host is blocked rather than merely unlikely.
  #
  # frame-src is openstreetmap.org for the maps. If فهد or the voice stop
  # working after a change here, the browser console names the directive.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: blob: https://*.supabase.co; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://unpkg.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://unpkg.com https://api.elevenlabs.io https://api.us.elevenlabs.io wss://api.elevenlabs.io wss://api.us.elevenlabs.io; frame-src https://www.openstreetmap.org; media-src 'self' blob: https://api.elevenlabs.io; worker-src 'self' blob:; manifest-src 'self'"
</IfModule>
