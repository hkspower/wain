# Wain — static export on Apache / LiteSpeed (Hostinger)
#
# Next.js `output: 'export'` with `trailingSlash: true` writes each route as a
# directory containing index.html, so no rewrite-to-index catch-all is needed
# — and must NOT be added, as it would mask real 404s.

ErrorDocument 404 /404.html
DirectoryIndex index.html

# Never serve this file itself.
<Files ".htaccess">
  Require all denied
</Files>

# ---------------------------------------------------------------------------
# Caching
#
# Two classes of file, and they need opposite policies:
#
#   1. /_next/static/**  — every .js, .css and .woff2 carries a content hash in
#      its filename, so a changed file is a *different URL*. These can be
#      cached for a year and never revalidated. `immutable` also stops browsers
#      re-checking them on reload.
#
#   2. Everything else — index.html, og.png, sitemap.xml … keep stable names,
#      so they must revalidate or a deploy would be invisible to returning
#      visitors. `no-cache` still allows 304s via ETag: cheap when unchanged,
#      correct when changed.
#
# A build guard (scripts/check-cache-safety.mjs) fails the build if an
# unhashed .js/.css/.woff2 ever appears outside /_next/static/, which would
# make the immutable rule below unsafe.
# ---------------------------------------------------------------------------

<IfModule mod_headers.c>
  # 1. Content-hashed build output — cache hard, forever.
  <FilesMatch "\.(js|mjs|css|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # 1b. The service worker is the one unhashed .js we ship, and it decides
  # which build every installed app runs. It must never be frozen by rule 1,
  # so this comes after it and wins.
  <Files "sw.js">
    Header set Cache-Control "public, max-age=0, must-revalidate"
    Header set Service-Worker-Allowed "/"
  </Files>

  # 2a. HTML and the RSC payloads beside it — always revalidate.
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # 2b. Stable-named media (incl. صوت وين clips) — a week in cache, then
  # revalidate.
  <FilesMatch "\.(png|jpg|jpeg|webp|avif|svg|ico|mp3)$">
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
  </FilesMatch>

  # 2c. Crawler and install metadata — short, so changes propagate quickly.
  <FilesMatch "\.(xml|webmanifest|json)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # Never let a proxy serve the wrong encoding.
  Header append Vary Accept-Encoding
</IfModule>

# Fallback for hosts without mod_headers.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                      "access plus 1 hour"
  ExpiresByType text/html             "access plus 0 seconds"
  ExpiresByType text/css              "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2            "access plus 1 year"
  ExpiresByType font/woff             "access plus 1 year"
  ExpiresByType image/png             "access plus 1 week"
  ExpiresByType image/svg+xml         "access plus 1 week"
  ExpiresByType image/x-icon          "access plus 1 week"
  ExpiresByType audio/mpeg            "access plus 1 week"
</IfModule>

# ---------------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------------

# Brotli first where available — noticeably smaller than gzip for text.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml \
    application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# woff2 is already compressed; re-compressing wastes CPU and can grow it.
<IfModule mod_setenvif.c>
  SetEnvIfNoCase Request_URI \.(woff2?|png|jpe?g|webp|avif|ico)$ no-gzip dont-vary
</IfModule>

# ---------------------------------------------------------------------------
# Correct types (some hosts do not know these by default)
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
</IfModule>

# ---------------------------------------------------------------------------
# Baseline security headers
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # فهد needs the microphone; nothing else on the site needs these features.
  Header set Permissions-Policy "camera=(), geolocation=(self), microphone=(self)"
</IfModule>
