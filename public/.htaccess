# Wain — static export on Apache / Hostinger
# Next.js `output: 'export'` with `trailingSlash: true` writes each route as
# a directory containing index.html, so no rewrite-to-index catch-all is needed
# (and must NOT be added — it would mask real 404s).

# Serve the exported 404 page for unknown paths.
ErrorDocument 404 /404.html

# Directory URLs resolve to their index.html automatically.
DirectoryIndex index.html

# Light caching for static assets; HTML stays fresh.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Compress text assets.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
