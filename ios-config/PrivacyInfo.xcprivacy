<?xml version="1.0" encoding="UTF-8"?>
<!--
  Apple's privacy manifest. Required for App Store submission since 1 May 2024;
  a build without one is rejected at upload.

  `ios/` is generated by `npx cap add ios` on every CI run and is gitignored,
  so this file lives here and `scripts/patch-ios-project.mjs` copies it in.

  WHAT IS DECLARED, AND WHY. Apple's "collect" means transmitted off the device.
  The list below is what this build sends when its back end is on, which the iOS
  build does (NEXT_PUBLIC_WAIN_BACKEND points at the live API, and the back end
  is on by default). Each entry was read from the code, and `audit:ios` fails if
  the source sends a field this file does not declare.

  · Name and phone number. An order and a queue ticket send the customer's name
    and phone (src/lib/orders.ts, src/lib/queue.ts). A business registration
    sends the owner's phone (src/lib/submissions.ts). Both identify a person, so
    they are declared as linked to them.

  · Other user content. An order's note (note_ar) and the text of a registration.

  · Photos. A registration's shop photos are uploaded to the server
    (src/lib/media.ts), and the server stores them until they are reviewed.

  · Precise location. CoordinatePicker and /add's «موقعي» read the device's
    position, and it is stored with the registration as lat and lng
    (src/lib/submissions.ts). Declared as linked because the same submission
    carries the owner's phone. The location of a business pin is not always the
    visitor's own; the owner confirms this entry against the privacy policy.

  · Audio. A شوق call streams the microphone to ElevenLabs to be transcribed. It
    is not linked to an identity (the app has no accounts) and is not used for
    tracking. The free call's speech recognition is the phone's own service, which
    wain does not receive or store.

  Where a type could be read as linked, it is declared as linked. This file is
  the owner's declaration against the privacy policy, not a legal opinion.

  · No tracking, and no tracking domains. There is no analytics SDK, advertising
    identifier or third-party measurement in the bundle. NSPrivacyTracking false
    is a claim `audit:ios` re-checks against the built export, not a promise made
    once.

  · UserDefaults is reached by Capacitor's own runtime, not by wain. CA92.1 is the
    reason code for "access solely to store or read data for the app itself",
    which is what a WebView shell does with it.
-->
<plist version="1.0">
<dict>
  <key>NSPrivacyTracking</key>
  <false/>

  <key>NSPrivacyTrackingDomains</key>
  <array/>

  <key>NSPrivacyCollectedDataTypes</key>
  <array>
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeName</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypePhoneNumber</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeOtherUserContent</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypePhotosorVideos</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypePreciseLocation</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeAudioData</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <false/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>
  </array>

  <key>NSPrivacyAccessedAPITypes</key>
  <array>
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>CA92.1</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
